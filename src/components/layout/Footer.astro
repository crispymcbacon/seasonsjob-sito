---
import { SOLUTIONS } from '@/config/solutions';
import Brand from '@/components/ui/Brand.astro';

const year = new Date().getFullYear();

const COMPANY_LINKS = [
  { label: 'Chi siamo', href: '/chi-siamo/' },
  { label: 'Casi reali', href: '/casi-reali/' },
  { label: 'Contatti', href: '/contatti/' },
];

const linkClass =
  'inline-flex min-h-8 items-center text-[0.9375rem] text-neutral-600 transition-colors hover:text-brand-600';
---

<footer class="border-t border-neutral-200 bg-white">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)_minmax(0,1fr)] lg:gap-16">
      <div class="sm:col-span-2 lg:col-span-1">
        <Brand size="sm" />
        <p class="mt-5 max-w-sm text-[0.9375rem] leading-relaxed text-neutral-600">
          Strumenti digitali per il settore alberghiero: personale stagionale,
          comande, acquisti e cantina. Ogni prodotto risolve un pezzo concreto
          del lavoro quotidiano.
        </p>
      </div>

      <nav aria-label="Soluzioni">
        <h2 class="text-sm font-bold tracking-wider text-ink uppercase">
          Soluzioni
        </h2>
        <ul class="mt-4 flex flex-col gap-1">
          {SOLUTIONS.map((solution) => (
            <li>
              <a href={solution.href} class={linkClass}>
                {solution.name}
                {solution.status === 'in-sviluppo' && (
                  <span class="ml-2 text-xs text-neutral-500">in sviluppo</span>
                )}
              </a>
            </li>
          ))}
          <li>
            <a href="/soluzioni/" class={linkClass}>
              Tutte le soluzioni
            </a>
          </li>
        </ul>
      </nav>

      <nav aria-label="Azienda">
        <h2 class="text-sm font-bold tracking-wider text-ink uppercase">
          Azienda
        </h2>
        <ul class="mt-4 flex flex-col gap-1">
          {COMPANY_LINKS.map((link) => (
            <li>
              <a href={link.href} class={linkClass}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-neutral-200 pt-6 text-sm text-neutral-500 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} SeasonsJob</p>
      <p>Tecnologia per il settore alberghiero, fatta con chi ci lavora.</p>
    </div>
  </div>
</footer>
