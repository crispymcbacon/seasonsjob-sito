---
import type { NavLink } from '@/config/site';

interface Props {
  links?: NavLink[];
  /** Inline for the desktop header row, stacked for the mobile menu panel. */
  variant?: 'inline' | 'stacked';
  label?: string;
}

const {
  links = [],
  variant = 'inline',
  label = 'Navigazione principale',
} = Astro.props;

const layouts = {
  inline: 'flex items-center gap-7',
  stacked: 'flex flex-col items-stretch gap-1',
};

const linkBase =
  'inline-flex items-center font-medium text-neutral-600 transition-colors hover:text-ink aria-[current=page]:text-brand-600 aria-[current=true]:text-brand-600';

const linkClasses = {
  inline: `${linkBase} min-h-10 text-[0.9375rem]`,
  stacked: `${linkBase} min-h-12 rounded-lg px-3 text-[1.0625rem] hover:bg-neutral-50`,
};

const current = Astro.url.pathname;

/**
 * `page` for the exact destination, `true` for the section the current page
 * belongs to (so /soluzioni/lavoro/ still marks Soluzioni as current).
 */
const currentState = (href: string) => {
  if (current === href) return 'page';
  if (href !== '/' && current.startsWith(href)) return 'true';
  return undefined;
};
---

<nav aria-label={label}>
  <ul class={layouts[variant]}>
    {links.map((link) => (
      <li>
        <a
          href={link.href}
          aria-current={currentState(link.href)}
          class={linkClasses[variant]}
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
