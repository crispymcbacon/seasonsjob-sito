---
import type { NavLink } from '@/config/site';

interface Props {
  links?: NavLink[];
}

const { links = [] } = Astro.props;
---

<nav aria-label="Navigazione principale">
  <ul class="flex items-center gap-6">
    {links.map((link) => (
      <li>
        <a
          href={link.href}
          aria-current={Astro.url.pathname === link.href ? 'page' : undefined}
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
