---
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';

/*
  Closing CTA banner: a focused, contained final step rather than a second hero.
*/
---

<section class="bg-neutral-50">
  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-16">
    <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-night px-6 py-10 text-center shadow-[0_12px_36px_rgba(15,22,19,0.12)] sm:px-10 sm:py-12 lg:px-12 lg:py-14">
      {/* Ambient background glow */}
      <div
        class="pointer-events-none absolute inset-x-0 -top-20 h-56 bg-[radial-gradient(ellipse_60%_60%_at_50%_0%,rgba(7,134,96,0.24),transparent_70%)]"
        aria-hidden="true"
      ></div>
      <div
        class="pointer-events-none absolute inset-x-0 -bottom-20 h-56 bg-[radial-gradient(ellipse_60%_60%_at_50%_100%,rgba(7,134,96,0.12),transparent_70%)]"
        aria-hidden="true"
      ></div>

      {/* Perspective geometric grid */}
      <div
        class="pointer-events-none absolute inset-0 cta-grid opacity-35"
        aria-hidden="true"
      ></div>

      <div class="relative z-10 mx-auto max-w-2xl">
        <p class="eyebrow text-neutral-400" data-reveal="fade">
          <span
            class="size-1.5 rounded-[2px] bg-brand-400"
            aria-hidden="true"
          ></span>
          Contatti
        </p>
        <h2
          class="font-display mx-auto mt-4 max-w-2xl text-[1.9rem] leading-[1.15] text-white sm:text-[2.35rem] md:text-[2.75rem]"
          data-reveal="title"
        >
          Partiamo da come lavora la{' '}
          <em class="font-display font-normal text-brand-300 italic">
            tua struttura
          </em>
          .
        </h2>

        <p
          class="mx-auto mt-4 max-w-xl text-[0.9375rem] leading-relaxed text-neutral-300 sm:text-base"
          data-reveal
          data-reveal-delay="1"
        >
          Raccontaci come lavora la tua struttura: capiamo insieme da dove
          partire.
        </p>

        <div
          class="mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-3.5"
          data-reveal
          data-reveal-delay="1"
        >
          <Button href="/contatti/" variant="inverted" size="md">
            Richiedi informazioni
            <Icon name="arrow-right" class="size-4" />
          </Button>
          <Button href="/soluzioni/" variant="inverted-secondary" size="md">
            Scopri le soluzioni
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-grid {
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.08) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.08) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(
      ellipse 80% 70% at 50% 55%,
      black 25%,
      transparent 80%
    );
    -webkit-mask-image: radial-gradient(
      ellipse 80% 70% at 50% 55%,
      black 25%,
      transparent 80%
    );
  }
</style>
