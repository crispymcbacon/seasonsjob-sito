---
/*
  "Casi reali" / Scenari di implementazione sul campo.
  Asymmetric 2-column layout: left column contains section narrative & vertical
  facility selectors; right column features the detailed framed architectural showcase.
*/
import CasePhotoFrame from '@/components/ui/CasePhotoFrame.astro';

interface UseCase {
  id: string;
  tabLabel: string;
  facility: string;
  logo: string;
  logoAlt: string;
  facilityType: string;
  image: string;
  imageAlt: string;
  imageWidth: number;
  imageHeight: number;
  scenarioTitle: string;
  badge: string;
  impact: string;
  summary: string;
  modules: string[];
}

const USE_CASES: UseCase[] = [
  {
    id: 'hotel-palace-danieli',
    tabLabel: 'Hotel Palace & Hotel Danieli · Bibione',
    facility: 'Hotel Palace & Hotel Danieli',
    logo: '/images/clients/hotel-palace.webp',
    logoAlt: 'Logo Hotel Palace',
    facilityType:
      'Hotel 4★ & Hotel 3★ · Bibione · Ristorazione e servizio di sala',
    image: '/images/cases/hotel-palace-danieli.webp',
    imageAlt: 'Hotel Palace e Hotel Danieli a Bibione con piscina',
    imageWidth: 1024,
    imageHeight: 768,
    scenarioTitle: 'Comande digitali per il servizio di sala',
    badge: 'Comande & Sala',
    impact: 'Ordini digitali e stampa automatica senza riscrivere le comande',
    summary:
      'Hotel Palace e Hotel Danieli prendono gli ordini con SeasonsJob Comande. La stampante stampa e taglia da sola ogni comanda: niente più ordini ricopiati a mano e meno tempo perso per il personale.',
    modules: [
      'SeasonsJob Comande',
      'Ordini clienti digitali',
      'Stampa e taglio automatici',
    ],
  },
  {
    id: 'hotel-helvetia',
    tabLabel: 'Hotel 4★ · Jesolo',
    facility: 'Hotel Helvetia',
    logo: '/images/clients/hotel-helvetia.webp',
    logoAlt: 'Logo Hotel Helvetia',
    facilityType: 'Hotel 4★ · Jesolo · Sala, Lounge Bar & Terrazza',
    image: '/images/cases/hotel-helvetia.webp',
    imageAlt: 'Hotel Helvetia a Jesolo illuminato di sera',
    imageWidth: 900,
    imageHeight: 500,
    scenarioTitle: 'Comande digitali e ordini ai fornitori con la voce',
    badge: 'Comande & Procuro',
    impact:
      'Dal servizio in sala agli ordini ai fornitori, con meno attività manuali',
    summary:
      'Hotel Helvetia prende gli ordini con SeasonsJob Comande, con la stessa stampa automatica. In più sta provando Procuro con noi: ordini ai fornitori con i suoi listini e la voce.',
    modules: [
      'SeasonsJob Comande',
      'SeasonsJob Procuro · in sviluppo',
      'Ordini con AI vocale',
    ],
  },
  {
    id: 'taverna-al-boccale',
    tabLabel: 'Ristorante & Taverna',
    facility: 'Taverna Al Boccale',
    logo: '/images/clients/taverna-al-boccale.webp',
    logoAlt: 'Logo Taverna Al Boccale',
    facilityType:
      'Ristorante & Taverna · 120 coperti · Birre artigianali & Cantina',
    image: '/images/cases/taverna-al-boccale.webp',
    imageAlt: 'Sala interna della Taverna Al Boccale',
    imageWidth: 550,
    imageHeight: 309,
    scenarioTitle: 'Inventario della cantina e assistenza AI sul vino',
    badge: 'Wine & AI',
    impact:
      'Ogni bottiglia sotto controllo, dall’inventario alle domande sul vino',
    summary:
      'Taverna Al Boccale tiene l’inventario della cantina con SeasonsJob Wine. Il personale scansiona una bottiglia per vedere se c’è e chiede all’AI dettagli o disponibilità.',
    modules: ['SeasonsJob Wine', 'Inventario bottiglie', 'Scansione e AI'],
  },
];
---

<section id="casi-reali" class="border-b border-neutral-200/80 bg-white">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-24">
    <div class="grid items-start gap-12 lg:grid-cols-12 lg:gap-14">
      {/* Left Column: Contextual Header + Vertical Facility Selector */}
      <div class="flex flex-col lg:col-span-5">
        <p class="eyebrow" data-reveal="fade">
          <span
            class="size-1.5 rounded-[2px] bg-brand-500"
            aria-hidden="true"
          />
          Casi reali
        </p>
        <h2
          class="font-display mt-4 text-[2rem] leading-[1.15] text-ink sm:text-[2.35rem]"
          data-reveal="title"
        >
          Applicazioni concrete{' '}
          <em class="font-display font-normal text-brand-700 italic">
            nelle strutture
          </em>
        </h2>

        <p
          class="mt-4 text-base leading-relaxed text-neutral-600 sm:text-lg"
          data-reveal
          data-reveal-delay="1"
        >
          Come li usano hotel, ristoranti e cantine, con esempi presi dal lavoro
          di tutti i giorni.
        </p>

        {/* Vertical Selector List */}
        <div
          class="mt-8 flex flex-col gap-2.5"
          role="tablist"
          aria-label="Seleziona scenario applicativo"
          data-reveal="scale"
          data-reveal-delay="2"
        >
          {USE_CASES.map((uc, index) => (
            <button
              type="button"
              role="tab"
              id={`uc-tab-${uc.id}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls={`uc-panel-${uc.id}`}
              tabindex={index === 0 ? 0 : -1}
              data-uc-target={uc.id}
              class:list={[
                'uc-trigger group flex w-full cursor-pointer items-center justify-between rounded-xl border p-3.5 text-left transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900',
                index === 0
                  ? 'border-neutral-900 bg-neutral-900 text-white shadow-sm'
                  : 'border-neutral-200/80 bg-neutral-50/60 text-neutral-700 hover:border-neutral-300 hover:bg-white',
              ]}
            >
              <div class="flex items-center gap-3">
                <span
                  class:list={[
                    'uc-indicator grid size-8 place-items-center rounded-lg text-xs font-bold transition-colors',
                    index === 0
                      ? 'bg-white/15 text-white'
                      : 'bg-white border border-neutral-200 text-neutral-500 group-hover:border-neutral-300 group-hover:text-ink',
                  ]}
                  aria-hidden="true"
                >
                  {index + 1}
                </span>
                <div>
                  <span class="block text-sm font-semibold tracking-tight">
                    {uc.facility}
                  </span>
                  <span
                    class:list={[
                      'uc-sub block text-xs transition-colors',
                      index === 0 ? 'text-neutral-300' : 'text-neutral-500',
                    ]}
                  >
                    {uc.tabLabel}
                  </span>
                </div>
              </div>

              <svg
                class:list={[
                  'uc-chevron size-4 transition-transform group-hover:translate-x-0.5',
                  index === 0 ? 'text-brand-400' : 'text-neutral-400',
                ]}
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          ))}
        </div>

        <div class="mt-8 border-t border-neutral-200/80 pt-6">
          <a
            href="/contatti/"
            class="inline-flex items-center gap-2 text-sm font-semibold text-brand-700 transition-colors hover:text-brand-800"
          >
            Vuoi vedere come funzionerebbe da te?
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      {/* Right Column: Framed Showcase Container */}
      <div class="lg:col-span-7" data-reveal="right" data-reveal-delay="1">
        <div class="relative overflow-hidden rounded-2xl border border-neutral-200/90 bg-neutral-50/60 p-4 sm:p-7 lg:p-9 shadow-xs">
          {/* Corner crosshairs registration marks */}
          <div
            class="pointer-events-none absolute top-3 left-3 size-3.5 border-t-2 border-l-2 border-brand-500/50"
            aria-hidden="true"
          ></div>
          <div
            class="pointer-events-none absolute top-3 right-3 size-3.5 border-t-2 border-r-2 border-brand-500/50"
            aria-hidden="true"
          ></div>
          <div
            class="pointer-events-none absolute bottom-3 left-3 size-3.5 border-b-2 border-l-2 border-brand-500/50"
            aria-hidden="true"
          ></div>
          <div
            class="pointer-events-none absolute bottom-3 right-3 size-3.5 border-b-2 border-r-2 border-brand-500/50"
            aria-hidden="true"
          ></div>

          {/* Background ambient dot grid */}
          <div
            class="usecase-grid pointer-events-none absolute inset-0 opacity-35"
            aria-hidden="true"
          ></div>

          {/* Panels */}
          {USE_CASES.map((uc, index) => (
            <div
              id={`uc-panel-${uc.id}`}
              role="tabpanel"
              aria-labelledby={`uc-tab-${uc.id}`}
              class:list={[
                'uc-panel relative z-10 rounded-xl border border-neutral-200/90 bg-white p-6 sm:p-8 shadow-[0_8px_30px_rgba(0,0,0,0.04)] transition-opacity duration-200',
                index !== 0 && 'hidden',
              ]}
            >
              {/* Facility Header */}
              <div class="flex flex-wrap items-start justify-between gap-4 border-b border-neutral-100 pb-5">
                <div class="flex items-center gap-3">
                  <div class="grid size-11 shrink-0 place-items-center overflow-hidden rounded-xl border border-neutral-200/80 bg-white p-1 shadow-xs">
                    <img
                      src={uc.logo}
                      alt={uc.logoAlt}
                      width="44"
                      height="44"
                      loading="lazy"
                      decoding="async"
                      class="size-full object-contain"
                    />
                  </div>
                  <div>
                    <h3 class="text-base font-semibold tracking-tight text-ink sm:text-lg">
                      {uc.facility}
                    </h3>
                    <p class="text-xs font-medium text-neutral-500">
                      {uc.facilityType}
                    </p>
                  </div>
                </div>
              </div>

              <CasePhotoFrame
                src={uc.image}
                alt={uc.imageAlt}
                width={uc.imageWidth}
                height={uc.imageHeight}
                fullBleed
                class="mt-6"
              />

              {/* Scenario & Narrative */}
              <div class="py-6">
                <div class="flex items-center gap-2">
                  <span class="size-1.5 rounded-full bg-brand-500"></span>
                  <h4 class="text-xs font-semibold tracking-wide text-brand-700 uppercase">
                    {uc.scenarioTitle}
                  </h4>
                </div>

                <blockquote class="mt-3.5 text-base sm:text-lg font-medium leading-relaxed text-neutral-800">
                  "{uc.summary}"
                </blockquote>
              </div>

              {/* Modules Footer */}
              <div class="border-t border-neutral-100 pt-5 text-xs leading-relaxed text-neutral-600">
                <span class="font-semibold text-neutral-700">
                  Moduli utilizzati:
                </span>{' '}
                {uc.modules.map((mod, moduleIndex) => (
                  <span>
                    {moduleIndex > 0 && ' · '}
                    {mod}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const ACTIVE_BTN = [
    'border-neutral-900',
    'bg-neutral-900',
    'text-white',
    'shadow-sm',
  ];
  const INACTIVE_BTN = [
    'border-neutral-200/80',
    'bg-neutral-50/60',
    'text-neutral-700',
    'hover:border-neutral-300',
    'hover:bg-white',
  ];

  const ACTIVE_INDICATOR = ['bg-white/15', 'text-white'];
  const INACTIVE_INDICATOR = [
    'bg-white',
    'border',
    'border-neutral-200',
    'text-neutral-500',
    'group-hover:border-neutral-300',
    'group-hover:text-ink',
  ];

  function initUseCaseSplit() {
    const root = document.getElementById('casi-reali');
    if (!root || root.dataset.useCaseReady === 'true') return;

    const triggers = root.querySelectorAll<HTMLButtonElement>('.uc-trigger');
    const panels = root.querySelectorAll<HTMLElement>('.uc-panel');

    if (!triggers.length || !panels.length) return;
    root.dataset.useCaseReady = 'true';

    function switchUseCase(targetId: string) {
      triggers.forEach((btn) => {
        const isTarget = btn.getAttribute('data-uc-target') === targetId;
        btn.setAttribute('aria-selected', isTarget ? 'true' : 'false');
        btn.tabIndex = isTarget ? 0 : -1;

        const indicator = btn.querySelector<HTMLElement>('.uc-indicator');
        const sub = btn.querySelector<HTMLElement>('.uc-sub');
        const chevron = btn.querySelector<SVGElement>('.uc-chevron');

        for (const cls of ACTIVE_BTN) btn.classList.toggle(cls, isTarget);
        for (const cls of INACTIVE_BTN) btn.classList.toggle(cls, !isTarget);

        if (indicator) {
          for (const cls of ACTIVE_INDICATOR)
            indicator.classList.toggle(cls, isTarget);
          for (const cls of INACTIVE_INDICATOR)
            indicator.classList.toggle(cls, !isTarget);
        }

        if (sub) {
          sub.classList.toggle('text-neutral-300', isTarget);
          sub.classList.toggle('text-neutral-500', !isTarget);
        }

        if (chevron) {
          chevron.classList.toggle('text-brand-400', isTarget);
          chevron.classList.toggle('text-neutral-400', !isTarget);
        }
      });

      panels.forEach((panel) => {
        const isTarget = panel.id === `uc-panel-${targetId}`;
        panel.classList.toggle('hidden', !isTarget);
      });
    }

    triggers.forEach((btn, index) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-uc-target');
        if (targetId) switchUseCase(targetId);
      });

      btn.addEventListener('keydown', (e) => {
        let newIndex = index;
        if (e.key === 'ArrowDown') {
          newIndex = (index + 1) % triggers.length;
        } else if (e.key === 'ArrowUp') {
          newIndex = (index - 1 + triggers.length) % triggers.length;
        } else if (e.key === 'Home') {
          newIndex = 0;
        } else if (e.key === 'End') {
          newIndex = triggers.length - 1;
        } else {
          return;
        }

        e.preventDefault();
        const newBtn = triggers[newIndex];
        newBtn.focus();
        const targetId = newBtn.getAttribute('data-uc-target');
        if (targetId) switchUseCase(targetId);
      });
    });
  }

  initUseCaseSplit();
  document.addEventListener('astro:page-load', initUseCaseSplit);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initUseCaseSplit);
  }
</script>

<style>
  .usecase-grid {
    background-image: radial-gradient(#d4d4d8 1.25px, transparent 1.25px);
    background-size: 20px 20px;
    mask-image: radial-gradient(
      ellipse 70% 70% at 50% 50%,
      black 20%,
      transparent 80%
    );
    -webkit-mask-image: radial-gradient(
      ellipse 70% 70% at 50% 50%,
      black 20%,
      transparent 80%
    );
  }
</style>
