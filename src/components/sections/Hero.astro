---
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import HeroEcosystem from './HeroEcosystem.astro';

/*
  Opening sequence: positioning + the ecosystem visual, followed by a compact
  three-column introduction. Kept in one section so the hero and the company
  introduction read as a single movement.
*/
const INTRO_ITEMS = [
  {
    label: 'Solo ospitalità',
    text: 'Progettiamo esclusivamente per hotel, ristoranti e strutture ricettive: nessuna funzione generica pensata per altri settori.',
  },
  {
    label: 'Problemi concreti',
    text: "Ogni prodotto parte da un'attività reale: coprire un turno, far arrivare una comanda in cucina, gestire un ordine, sapere cosa resta in cantina.",
  },
  {
    label: 'Aree diverse',
    text: 'Lavoro, Comande, Procuro e Wine intervengono su parti diverse del lavoro quotidiano e si scelgono in base alle esigenze della struttura.',
  },
];
---

<section class="border-b border-neutral-200/80 bg-white">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="grid items-center gap-14 pt-14 pb-16 lg:grid-cols-12 lg:gap-10 lg:pt-20 lg:pb-20">
      <div class="hero-copy flex flex-col items-start gap-6 lg:col-span-6">
        <p class="flex items-center gap-2 text-sm font-semibold text-brand-600">
          <span
            class="size-1.5 rounded-full bg-brand-500"
            aria-hidden="true"
          ></span>
          Software per l'ospitalità
        </p>

        <h1 class="text-[2rem] leading-[1.12] sm:text-[2.5rem] lg:text-[2.75rem] xl:text-[3rem]">
          Strumenti digitali per il lavoro quotidiano in struttura.
        </h1>

        <p class="max-w-xl text-lg leading-relaxed text-neutral-600">
          SeasonsJob sviluppa software per hotel, ristoranti e strutture
          ricettive: quattro prodotti, ognuno specializzato in una parte diversa
          delle operazioni quotidiane.
        </p>

        <div class="mt-2 flex w-full flex-col gap-3 sm:w-auto sm:flex-row sm:items-center">
          <Button href="#soluzioni" size="lg">
            Scopri le soluzioni
            <Icon name="arrow-right" class="size-4" />
          </Button>
          <Button href="/contatti/" variant="secondary" size="lg">
            Richiedi informazioni
          </Button>
        </div>
      </div>

      <div class="lg:col-span-6 lg:pl-6">
        <HeroEcosystem />
      </div>
    </div>

    <!-- Company introduction: same opening sequence, tighter rhythm. -->
    <ul
      class="grid gap-8 border-t border-neutral-200 py-12 sm:grid-cols-3 sm:gap-10 sm:py-14"
      data-reveal
    >
      {INTRO_ITEMS.map((item) => (
        <li class="flex max-w-sm flex-col gap-2">
          <p class="text-xs font-semibold tracking-[0.14em] text-brand-600 uppercase">
            {item.label}
          </p>
          <p class="text-sm leading-relaxed text-neutral-600">{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /*
    Load animation for the opening copy. Pure CSS, staggered with custom
    properties, disabled by the global prefers-reduced-motion rules.
  */
  .hero-copy > * {
    animation: hero-in 700ms cubic-bezier(0.22, 0.7, 0.3, 1) both;
  }
  .hero-copy > :nth-child(1) {
    animation-delay: 60ms;
  }
  .hero-copy > :nth-child(2) {
    animation-delay: 130ms;
  }
  .hero-copy > :nth-child(3) {
    animation-delay: 200ms;
  }
  .hero-copy > :nth-child(4) {
    animation-delay: 270ms;
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
