---
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import HeroEcosystem from './HeroEcosystem.astro';

/*
  Opening sequence: positioning + the ecosystem visual, followed by a compact
  introduction. Kept in one section so the hero and the company introduction
  read as a single movement.
*/
const INTRO_POINTS = [
  {
    title: 'Costruiti per l’hospitality',
    text: 'Non software generico adattato: ogni prodotto nasce da come lavorano davvero hotel e ristoranti.',
  },
  {
    title: 'Problemi concreti',
    text: 'Turni da coprire, comande da passare, ordini da fare, bottiglie da contare. Da qui partiamo.',
  },
  {
    title: 'Uno strumento per ogni parte del lavoro',
    text: 'Persone, operatività, acquisti e inventario: aree diverse, stessa famiglia di prodotti.',
  },
];
---

<section class="border-b border-neutral-200/80 bg-white">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="grid items-center gap-14 pt-14 pb-16 lg:grid-cols-12 lg:gap-10 lg:pt-20 lg:pb-20">
      <div class="hero-copy flex flex-col items-start lg:col-span-6">
        <p class="eyebrow">Tecnologia per l’hospitality</p>

        <h1 class="mt-4 text-[2.25rem] leading-[1.1] sm:text-[2.75rem] lg:text-[3.25rem]">
          Strumenti digitali pensati per chi lavora nell’ospitalità
        </h1>

        <p class="mt-6 max-w-xl text-lg leading-relaxed text-neutral-600 sm:text-xl">
          SeasonsJob sviluppa una famiglia di prodotti specializzati per hotel,
          ristoranti e strutture ricettive: personale stagionale, comande,
          acquisti e cantina. Ogni strumento fa bene una cosa, e la fa dentro il
          vostro modo di lavorare.
        </p>

        <div class="mt-8 flex w-full flex-col gap-3 sm:w-auto sm:flex-row sm:items-center">
          <Button href="#soluzioni" size="lg">
            Scopri le soluzioni
            <Icon name="arrow-right" class="size-4" />
          </Button>
          <Button href="/contatti/" variant="secondary" size="lg">
            Richiedi informazioni
          </Button>
        </div>
      </div>

      <div class="lg:col-span-6 lg:pl-6">
        <HeroEcosystem />
      </div>
    </div>

    <!-- Company introduction: same opening sequence, tighter rhythm. -->
    <dl
      class="grid gap-8 border-t border-neutral-200 py-12 sm:grid-cols-3 sm:gap-10 sm:py-14"
      data-reveal
    >
      {INTRO_POINTS.map((point, i) => (
        <div class="flex max-w-sm flex-col gap-2">
          <dt class="flex items-baseline gap-2 font-semibold text-ink">
            <span
              class="text-xs font-semibold text-brand-500 tabular-nums"
              aria-hidden="true"
            >
              {String(i + 1).padStart(2, '0')}
            </span>
            {point.title}
          </dt>
          <dd class="text-[0.9375rem] leading-relaxed text-neutral-600">
            {point.text}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  /*
    Load animation for the opening copy. Pure CSS, staggered with custom
    properties, disabled by the global prefers-reduced-motion rules.
  */
  .hero-copy > * {
    animation: hero-in 700ms cubic-bezier(0.22, 0.7, 0.3, 1) both;
  }
  .hero-copy > :nth-child(1) {
    animation-delay: 60ms;
  }
  .hero-copy > :nth-child(2) {
    animation-delay: 130ms;
  }
  .hero-copy > :nth-child(3) {
    animation-delay: 200ms;
  }
  .hero-copy > :nth-child(4) {
    animation-delay: 270ms;
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
