---
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/components/ui/icon-set';
interface Props {
  name: string;
  description: string;
  icon: IconName;
  slug: string;
  color: string;
  delay: number;
  development?: boolean;
}
const {
  name,
  description,
  icon,
  slug,
  color,
  delay,
  development = false,
} = Astro.props;
---

<li
  class:list={['hero-product', slug]}
  style={`--accent:${color};--delay:${delay}ms`}
>
  <div class="product-drift">
    <a href={`/soluzioni/${slug}/`} class="product-link">
      <span class="product-icon" aria-hidden="true">
        <Icon name={icon} class="size-6" />
      </span>
      <span class="product-text">
        <span class="product-name">{name}</span>
        <span class="product-description">{description}</span>
      </span>
      {development && <span class="development">In sviluppo</span>}
    </a>
  </div>
</li>
<style>
  .hero-product {
    position: absolute;
    width: 248px;
    z-index: 3;
    animation: product-in 650ms ease-out var(--delay) both;
  }
  .lavoro {
    left: 4%;
    top: 19%;
    --tilt: -4deg;
  }
  .procuro {
    right: 3.5%;
    top: 17%;
    --tilt: 3deg;
  }
  .comande {
    left: 2.5%;
    top: 61%;
    --tilt: 4deg;
  }
  .wine {
    right: 4%;
    top: 63%;
    --tilt: -4deg;
  }
  .product-drift {
    animation: drift 9s ease-in-out calc(var(--delay) * -12) infinite;
    animation-play-state: paused;
  }
  :global([data-motion='running']) .product-drift {
    animation-play-state: running;
  }
  .product-link {
    display: flex;
    align-items: center;
    gap: 14px;
    position: relative;
    padding: 20px 18px;
    border: 1px solid #fff;
    border-radius: 16px;
    background: #ffffffed;
    box-shadow:
      0 12px 35px -18px color-mix(in srgb, var(--accent) 24%, transparent),
      0 2px 8px #22222203;
    transform: rotate(var(--tilt));
    transition: border-color 180ms;
  }
  .product-link:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, white);
  }
  .product-link:focus-visible {
    outline-color: var(--accent);
  }
  .product-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 48px;
    height: 52px;
    border-radius: 13px;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 9%, white);
  }
  .product-name {
    display: block;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
  }
  .product-description {
    display: block;
    margin-top: 5px;
    font-size: 0.9rem;
    color: #646866;
    line-height: 1.3;
  }
  .development {
    position: absolute;
    right: 12px;
    top: -13px;
    border: 1px solid #e6e0f2;
    background: #f0ebf8;
    color: #67518b;
    border-radius: 6px;
    padding: 2px 9px;
    font-size: 0.72rem;
    font-weight: 600;
  }
  @keyframes product-in {
    from {
      opacity: 0;
      translate: 0 10px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
  @keyframes drift {
    0%,
    100% {
      transform: translateY(-3px);
    }
    50% {
      transform: translateY(4px);
    }
  }
  @media (min-width: 1100px) {
    .hero-product {
      width: 268px;
    }
    .lavoro {
      left: 6%;
      top: 23%;
      --tilt: -3deg;
    }
    .procuro {
      right: 5%;
      top: 20%;
      --tilt: 2deg;
    }
    .comande {
      left: 4%;
      top: 61%;
      --tilt: 3deg;
    }
    .wine {
      right: 6%;
      top: 64%;
      --tilt: -3deg;
    }
    .product-drift {
      position: relative;
      animation-name: planet-drift;
      animation-duration: 12s;
    }
    .procuro .product-drift {
      animation-duration: 15s;
    }
    .comande .product-drift {
      animation-duration: 13s;
    }
    .wine .product-drift {
      animation-duration: 17s;
    }
    .product-link {
      background: #fff;
      box-shadow:
        0 18px 40px -24px color-mix(in srgb, var(--accent) 35%, transparent),
        0 3px 12px #22222203;
    }
    .product-icon {
      width: 62px;
      height: 66px;
    }
  }
  @keyframes planet-drift {
    0%,
    100% {
      transform: translate(-5px, -9px) rotate(-1deg);
    }
    33% {
      transform: translate(6px, -2px) rotate(0.7deg);
    }
    66% {
      transform: translate(2px, 10px) rotate(-0.4deg);
    }
  }
  @media (min-width: 1100px) {
    .product-icon :global(.icon) {
      width: 34px;
      height: 34px;
    }
  }
  @media (min-width: 1100px) and (max-width: 1300px) {
    .hero-product {
      width: 208px;
    }
    .product-link {
      padding: 15px 12px;
      gap: 10px;
    }
    .product-icon {
      width: 46px;
      height: 52px;
    }
    .lavoro,
    .comande {
      left: 2%;
    }
    .procuro,
    .wine {
      right: 2%;
    }
  }
  @media (max-width: 1099px) {
    .hero-product {
      position: relative;
      inset: auto;
      width: min(100%, 250px);
    }
    .product-link {
      display: grid;
      grid-template-columns: 38px minmax(0, 1fr);
      gap: 10px 12px;
      padding: 16px;
      background: #fff;
      align-items: center;
    }
    .product-text {
      display: contents;
    }
    .product-icon {
      grid-column: 1;
      grid-row: 1;
      width: 38px;
      height: 40px;
    }
    .product-name {
      grid-column: 2;
      grid-row: 1;
    }
    .product-description {
      grid-column: 1 / -1;
      margin: 0;
      line-height: 1.4;
    }
    .lavoro {
      justify-self: end;
      margin-right: 16px;
    }
    .procuro {
      justify-self: start;
      margin-top: 22px;
    }
    .comande {
      justify-self: end;
      margin-right: 38px;
      margin-top: 5px;
    }
    .wine {
      justify-self: start;
      margin-left: 12px;
      margin-top: 25px;
    }
  }
  @media (max-width: 599px) {
    .hero-product {
      position: absolute;
      width: max-content;
      max-width: 100%;
      margin: 0;
    }
    .lavoro {
      left: 3%;
      top: 4px;
    }
    .procuro {
      right: 0;
      top: 50px;
    }
    .comande {
      left: 0;
      top: 112px;
    }
    .wine {
      right: 7%;
      top: 164px;
    }
    .lavoro,
    .wine {
      --tilt: -2deg;
    }
    .procuro,
    .comande {
      --tilt: 2deg;
    }
    .product-link {
      grid-template-columns: 32px auto;
      padding: 11px 14px;
      gap: 9px;
      border-radius: 12px;
    }
    .product-icon {
      width: 32px;
      height: 34px;
      border-radius: 8px;
    }
    .product-icon :global(.icon) {
      width: 19px;
      height: 19px;
    }
    .product-name {
      font-size: 1rem;
    }
    /* Keep the descriptions in each link's accessible name without making
       the small-screen constellation into four large text panels. */
    .product-description {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
      border: 0;
    }
    .development {
      font-size: 0.65rem;
      right: 5px;
    }
  }
  @media (max-width: 359px) {
    .wine {
      top: 176px;
      right: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-product,
    .product-drift {
      animation: none;
    }
  }
</style>
