---
import SolutionsTabs from '@/components/sections/SolutionsTabs.astro';

/*
  Core section of the homepage.

  The four products are presented as one connected ecosystem: a single
  interactive preview (Astro + vanilla JS, no framework hydration) that
  switches between Lavoro, Comande, Procuro and Wine, with the copy above
  explaining the idea the tabs then demonstrate.
*/
---

<section id="soluzioni" class="border-b border-neutral-200/80 bg-neutral-50">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-24">
    <div class="mx-auto flex max-w-4xl flex-col items-center text-center">
      <p class="eyebrow" data-reveal="fade">
        <span class="size-1.5 rounded-[2px] bg-brand-500" aria-hidden="true" />I
        quattro prodotti
      </p>
      <h2
        class="font-display mt-5 text-[2.25rem] leading-[1.1] tracking-tight text-ink sm:text-[2.75rem] md:text-[3.25rem] lg:text-[3.5rem]"
        data-reveal="title"
      >
        Tutti i flussi della struttura,{' '}
        <em class="font-display font-normal text-brand-700 italic">
          in un unico sistema
        </em>
      </h2>

      <p
        class="mt-5 text-lg leading-relaxed text-neutral-600"
        data-reveal
        data-reveal-delay="1"
      >
        Personale, sala, fornitori, cantina. Quattro strumenti che lavorano
        insieme, senza passare da un programma all'altro.
      </p>
    </div>

    <div class="mt-12 sm:mt-14" data-reveal="scale">
      <SolutionsTabs />
    </div>

    <p class="mt-8 text-center text-[0.9375rem] text-neutral-500" data-reveal>
      <a
        href="/soluzioni/"
        class="font-medium text-brand-700 transition-colors hover:text-brand-600"
      >
        Scopri tutte le soluzioni
      </a>
    </p>
  </div>
</section>
