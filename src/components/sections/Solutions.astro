---
import SolutionsTabs from '@/components/sections/SolutionsTabs.astro';

/*
  Core section of the homepage.

  The four products are presented as one connected ecosystem: a single
  interactive preview (Astro + vanilla JS, no framework hydration) that
  switches between Lavoro, Comande, Procuro and Wine, with the copy above
  explaining the idea the tabs then demonstrate.
*/
---

<section id="soluzioni" class="border-b border-neutral-200/80 bg-neutral-50">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-24">
    <div
      class="mx-auto flex max-w-4xl flex-col items-center text-center"
      data-reveal
    >
      <p class="inline-flex items-center gap-2.5 text-lg font-medium text-[#777777]">
        <span class="size-2 rounded-[2px] bg-brand-500" aria-hidden="true" />
        Unico ecosistema
      </p>

      <h2 class="font-display mt-5 text-[2.25rem] leading-[1.1] tracking-tight text-ink sm:text-[2.75rem] md:text-[3.25rem] lg:text-[3.5rem]">
        Costruendo ogni flusso del{' '}
        <em class="font-display font-normal text-brand-700 italic">
          settore alberghiero
        </em>
      </h2>

      <p class="mt-5 text-lg leading-relaxed text-neutral-600">
        Dal personale alle comande di sala, dagli acquisti ai fornitori alla
        gestione della cantina: SeasonsJob unisce l’intera operatività della
        struttura in un’unica esperienza coerente.
      </p>
    </div>

    <div class="mt-12 sm:mt-14">
      <SolutionsTabs />
    </div>

    <p class="mt-8 text-center text-[0.9375rem] text-neutral-500">
      <a
        href="/soluzioni/"
        class="font-medium text-brand-700 transition-colors hover:text-brand-600"
      >
        Scopri tutte le soluzioni
      </a>
    </p>
  </div>
</section>
