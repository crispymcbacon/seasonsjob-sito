  {/* External Context Line beneath the iPad */}
  <div class="mx-auto mt-3.5 flex max-w-4xl items-center justify-between px-3 text-xs text-neutral-500">
    <span data-context-caption>
      Interfaccia tablet di sala per camerieri e pass
    </span>
    <a
      data-context-link
      href="/soluzioni/comande/"
      class="inline-flex items-center gap-1 font-semibold text-brand-700 transition-colors hover:text-brand-800"
    >
      <span data-context-label>Scopri SeasonsJob Comande</span>
      <span aria-hidden="true">→</span>
    </a>
