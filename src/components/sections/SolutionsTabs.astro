<style>
  /* The tab rail scrolls horizontally on mobile without showing a scrollbar. */
  .no-scrollbar {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  /*
    Progressive enhancement for the tablist and stepper counter:
    The panels and counts are server-rendered static HTML, enhanced with zero external dependencies.
  */
  const TAB_ACTIVE_CLASSES = ['bg-[#333333]', 'text-white'];
  const TAB_INACTIVE_CLASSES = [
    'text-neutral-600',
    'hover:bg-neutral-100',
    'hover:text-ink',
  ];

  const CONTEXT_MAP: Record<
    string,
    { caption: string; href: string; label: string }
  > = {
    comande: {
      caption: 'Interfaccia tablet di sala per camerieri e pass',
      href: '/soluzioni/comande/',
      label: 'Scopri SeasonsJob Comande',
    },
    lavoro: {
      caption: 'Ricerca e gestione del personale stagionale alberghiero',
      href: '/soluzioni/lavoro/',
      label: 'Scopri SeasonsJob Lavoro',
    },
    procuro: {
      caption: 'Gestione acquisti merci, riordini e fornitori',
      href: '/soluzioni/procuro/',
      label: 'Scopri SeasonsJob Procuro',
    },
    wine: {
      caption: 'Carta dei vini digitale e inventario cantina',
      href: '/soluzioni/wine/',
      label: 'Scopri SeasonsJob Wine',
    },
  };

  const initTablist = (root: HTMLElement): void => {
    if (root.dataset.tabsReady === 'true') return;

    const buttons = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[data-tab-target]'),
    );
    const panels = Array.from(
      root.querySelectorAll<HTMLElement>('[data-tab-panel]'),
    );
    if (buttons.length === 0 || panels.length === 0) return;

    root.dataset.tabsReady = 'true';

    const scrollableTablist =
      root.querySelector<HTMLElement>('[data-tabs-scroll]');
    const scrollHint = root.querySelector<HTMLElement>(
      '[data-tab-scroll-hint]',
    );
    if (scrollableTablist && scrollHint) {
      const updateScrollHint = (): void => {
        const hasOverflow =
          scrollableTablist.scrollWidth > scrollableTablist.clientWidth + 1;
        const reachedEnd =
          scrollableTablist.scrollLeft + scrollableTablist.clientWidth >=
          scrollableTablist.scrollWidth - 1;
        scrollHint.classList.toggle('hidden', !hasOverflow || reachedEnd);
      };

      updateScrollHint();
      scrollableTablist.addEventListener('scroll', updateScrollHint, {
        passive: true,
      });
      window.addEventListener('resize', updateScrollHint);
    }

    const activate = (target: string): void => {
      for (const button of buttons) {
        const isActive = button.dataset.tabTarget === target;
        button.setAttribute('aria-selected', isActive ? 'true' : 'false');
        button.tabIndex = isActive ? 0 : -1;
        for (const className of TAB_ACTIVE_CLASSES) {
          button.classList.toggle(className, isActive);
        }
        for (const className of TAB_INACTIVE_CLASSES) {
          button.classList.toggle(className, !isActive);
        }
      }

      for (const panel of panels) {
        const isActive = panel.dataset.tabPanel === target;
        panel.classList.toggle('hidden', !isActive);
      }

      const contextData = CONTEXT_MAP[target];
      if (contextData) {
        const captionEl = root.querySelector('[data-context-caption]');
        const linkEl = root.querySelector<HTMLAnchorElement>(
          '[data-context-link]',
        );
        const labelEl = root.querySelector('[data-context-label]');
        if (captionEl) captionEl.textContent = contextData.caption;
        if (linkEl) linkEl.href = contextData.href;
        if (labelEl) labelEl.textContent = contextData.label;
      }
    };

    /** Standard tablist keyboard pattern: arrows wrap, Home/End jump. */
    const focusTab = (index: number): void => {
      const next = (index + buttons.length) % buttons.length;
      const button = buttons[next];
      const target = button.dataset.tabTarget;
      if (target === undefined) return;
      activate(target);
      button.focus();
    };

    buttons.forEach((button, index) => {
      button.addEventListener('click', () => {
        const target = button.dataset.tabTarget;
        if (target !== undefined) activate(target);
      });

      button.addEventListener('keydown', (event: KeyboardEvent) => {
        let next: number | undefined;

        switch (event.key) {
          case 'ArrowRight':
            next = index + 1;
            break;
          case 'ArrowLeft':
            next = index - 1;
            break;
          case 'Home':
            next = 0;
            break;
          case 'End':
            next = buttons.length - 1;
            break;
          default:
            return;
        }

        event.preventDefault();
        focusTab(next);
      });
    });
  };

  const initSteppers = (): void => {
    document
      .querySelectorAll<HTMLButtonElement>('[data-stepper-btn]')
      .forEach((btn) => {
        if (btn.dataset.stepperReady === 'true') return;
        btn.dataset.stepperReady = 'true';
        btn.addEventListener('click', () => {
          const action = btn.dataset.stepperBtn;
          const container = btn.closest('.stepper-container');
          const valEl = container?.querySelector<HTMLElement>(
            '[data-stepper-value]',
          );
          if (!valEl) return;
          let count = parseInt(valEl.textContent?.trim() || '0', 10);
          if (action === 'plus') {
            count += 1;
          } else if (action === 'minus' && count > 0) {
            count -= 1;
          }
          valEl.textContent = count.toString();
        });
      });
  };

  const initLavoroSubtabs = (): void => {
    document
      .querySelectorAll<HTMLElement>('[data-tab-panel="lavoro"]')
      .forEach((panel) => {
        if (panel.dataset.lavoroReady === 'true') return;
        panel.dataset.lavoroReady = 'true';

        const tabButtons = Array.from(
          panel.querySelectorAll<HTMLButtonElement>('[data-lavoro-tab]'),
        );
        const tabPanels = Array.from(
          panel.querySelectorAll<HTMLElement>('[data-lavoro-panel]'),
        );

        tabButtons.forEach((btn) => {
          btn.addEventListener('click', () => {
            const target = btn.dataset.lavoroTab;
            tabButtons.forEach((b) => {
              const isActive = b.dataset.lavoroTab === target;
              b.setAttribute('aria-selected', isActive ? 'true' : 'false');
              b.classList.toggle('border-neutral-900', isActive);
              b.classList.toggle('text-neutral-900', isActive);
              b.classList.toggle('font-extrabold', isActive);
              b.classList.toggle('border-transparent', !isActive);
              b.classList.toggle('text-neutral-500', !isActive);
              b.classList.toggle('font-semibold', !isActive);
            });
            tabPanels.forEach((p) => {
              const isActive = p.dataset.lavoroPanel === target;
              p.classList.toggle('hidden', !isActive);
            });
          });
        });
      });
  };

  const initProcuroMasterDetail = (): void => {
    document
      .querySelectorAll<HTMLElement>('[data-tab-panel="procuro"]')
      .forEach((panel) => {
        if (panel.dataset.procuroReady === 'true') return;
        panel.dataset.procuroReady = 'true';

        const itemButtons = Array.from(
          panel.querySelectorAll<HTMLButtonElement>('[data-procuro-target]'),
        );
        const detailPanels = Array.from(
          panel.querySelectorAll<HTMLElement>('[data-procuro-panel]'),
        );

        itemButtons.forEach((btn) => {
          btn.addEventListener('click', () => {
            const target = btn.dataset.procuroTarget;
            itemButtons.forEach((b) => {
              const isActive = b.dataset.procuroTarget === target;
              b.classList.toggle('border-2', isActive);
              b.classList.toggle('border-[#158154]', isActive);
              b.classList.toggle('bg-[#f0fdf4]/40', isActive);
              b.classList.toggle('border-neutral-200/90', !isActive);
              b.classList.toggle('bg-white', !isActive);
            });
            detailPanels.forEach((p) => {
              const isActive = p.dataset.procuroPanel === target;
              p.classList.toggle('hidden', !isActive);
            });
          });
        });
      });
  };

  const initWineMasterDetail = (): void => {
    document
      .querySelectorAll<HTMLElement>('[data-tab-panel="wine"]')
      .forEach((panel) => {
        if (panel.dataset.wineReady === 'true') return;
        panel.dataset.wineReady = 'true';

        const itemButtons = Array.from(
          panel.querySelectorAll<HTMLButtonElement>('[data-wine-target]'),
        );
        const detailPanels = Array.from(
          panel.querySelectorAll<HTMLElement>('[data-wine-panel]'),
        );

        itemButtons.forEach((btn) => {
          btn.addEventListener('click', () => {
            const target = btn.dataset.wineTarget;
            itemButtons.forEach((b) => {
              const isActive = b.dataset.wineTarget === target;
              b.classList.toggle('ring-2', isActive);
              b.classList.toggle('ring-[#158154]', isActive);
              b.classList.toggle('bg-[#f0fdf4]/30', isActive);
              b.classList.toggle('border-neutral-300', isActive);
              b.classList.toggle('border-neutral-200/90', !isActive);
              b.classList.toggle('bg-white', !isActive);
            });
            detailPanels.forEach((p) => {
              const isActive = p.dataset.winePanel === target;
              p.classList.toggle('hidden', !isActive);
            });
          });
        });
      });
  };

  const initAll = (): void => {
    const roots = document.querySelectorAll<HTMLElement>(
      '[data-solutions-tabs]',
    );
    roots.forEach(initTablist);
    initSteppers();
    initLavoroSubtabs();
    initProcuroMasterDetail();
    initWineMasterDetail();
  };

  initAll();
  document.addEventListener('astro:page-load', initAll);
</script>
