---
/**
 * Interactive "Soluzioni" tabbed preview for the homepage.
 *
 * One tab per SeasonsJob product (Lavoro, Comande, Procuro, Wine), each showing
 * a tablet mockup of that product in use. The markup for all four panels is
 * server-rendered; the only client-side JavaScript is a small progressive
 * enhancement that toggles the `hidden` class, so the content stays readable
 * and indexable without hydration.
 *
 * Comande features a compact, pixel-accurate recreation of the real SeasonsJob iPad app UI.
 */

/** Badge tone inside the product mockup, not a site-wide semantic scale. */
type Tone = 'active' | 'attention' | 'neutral';

/** Lucide icon names used by the mockup action bar. */
type IconKey =
  | 'arrow-right'
  | 'printer'
  | 'sliders'
  | 'user-plus'
  | 'list-checks'
  | 'plus'
  | 'arrow-left-right'
  | 'arrow-up-down'
  | 'archive';

type TabId = 'comande' | 'lavoro' | 'procuro' | 'wine';

import Icon from '@/components/ui/Icon.astro';

interface Card {
  title: string;
  category: string;
  status: string;
  tone: Tone;
  meta: string;
  image: string;
  imageAlt: string;
}

interface Tab {
  id: TabId;
  label: string;
  product: string;
  href: string;
  context: string;
  status: string;
  alert: { time: string; text: string; initials: string };
  cards: Card[];
  actions: { label: string; icon: IconKey }[];
  detailsLabel: string;
  contextCaption: string;
}

interface ComandeDish {
  title: string;
  en: string;
  de: string;
  count: number;
  hasActiveNote?: boolean;
}

/** Real dishes from the actual SeasonsJob Comande app */
const COMANDE_DISHES: ComandeDish[] = [
  {
    title: 'Crespellina al profumo di mare',
    en: 'Sea-scented crepe',
    de: 'Crêpe mit Meeresduft',
    count: 0,
    hasActiveNote: false,
  },
  {
    title: 'Fusilli ai porri, salsiccia e zafferano',
    en: 'Fusilli with leeks, sausage and saffron',
    de: 'Fusilli mit Lauch, Wurst und Safran',
    count: 1,
    hasActiveNote: true,
  },
  {
    title: 'Ravioli di ricotta e spinaci al burro (V)',
    en: 'Ricotta and spinach ravioli with butter (V)',
    de: 'Ravioli mit Ricotta und Spinat in Butter (V)',
    count: 0,
    hasActiveNote: false,
  },
];

/** Unsplash delivery parameters, shared by secondary tabs */
const PHOTO = 'auto=format&fit=crop&w=600&q=80';

const photo = (id: string): string =>
  `https://images.unsplash.com/photo-${id}?${PHOTO}`;

const TABS: Tab[] = [
  {
    id: 'comande',
    label: 'Comande & Sala',
    product: 'Comande',
    href: '/soluzioni/comande/',
    context: 'Tavolo 14 — Sala Veranda',
    status: 'Stato: Servizio attivo',
    alert: {
      time: 'Oggi, 20:45',
      text: 'Tavolo 14 (4 coperti): inviate 2 tagliate al rosmarino e 1 risotto alla zucca in cucina.',
      initials: 'MB',
    },
    cards: [],
    actions: [
      { label: 'Stampa comanda', icon: 'printer' },
      { label: 'Preferenze tavolo', icon: 'sliders' },
    ],
    detailsLabel: 'Vedi dettagli SeasonsJob Comande',
    contextCaption: 'Interfaccia tablet di sala per camerieri e pass',
  },
  {
    id: 'lavoro',
    label: 'Gestione Lavoro',
    product: 'Lavoro',
    href: '/soluzioni/lavoro/',
    context: 'Settimana 32 — 42 collaboratori attivi',
    status: 'Stato: Turni confermati',
    alert: {
      time: 'Oggi, 17:10',
      text: 'Richiesta cambio turno approvata: Marco R. copre il servizio cena in sala per domani.',
      initials: 'GL',
    },
    cards: [
      {
        title: 'Turno Serale — Sala Principale',
        category: 'Sala',
        status: 'Confermato',
        tone: 'active',
        meta: '6 addetti · 19:00 – 00:30',
        image: photo('1517248135467-4c7edcad34c4'),
        imageAlt: 'Sala del ristorante illuminata durante il servizio',
      },
      {
        title: 'Linea Calda — Servizio Cena',
        category: 'Cucina',
        status: 'Confermato',
        tone: 'active',
        meta: '4 cuochi · 18:30 – 23:30',
        image: photo('1556910103-1c02745aae4d'),
        imageAlt: 'Chef al lavoro davanti alla linea calda',
      },
      {
        title: 'Copertura Extra — Sabato Pranzo',
        category: 'Extra',
        status: '1 da confermare',
        tone: 'attention',
        meta: '2 baristi · 11:30 – 16:00',
        image: photo('1551218808-94e220e084d2'),
        imageAlt: 'Barista intento a preparare un cocktail al bancone',
      },
      {
        title: 'Riconciliazione Presenze Settimana 31',
        category: 'Presenze',
        status: 'Da chiudere',
        tone: 'neutral',
        meta: '38 cartellini convalidati',
        image: photo('1454165804606-c3d57bc86b40'),
        imageAlt: 'Documento di lavoro e penna su una scrivania',
      },
    ],
    actions: [
      { label: 'Aggiungi turno extra', icon: 'user-plus' },
      { label: 'Esporta presenze', icon: 'list-checks' },
    ],
    detailsLabel: 'Vedi dettagli SeasonsJob Lavoro',
    contextCaption: 'Ricerca e gestione del personale stagionale alberghiero',
  },
  {
    id: 'procuro',
    label: 'Ordini & Fornitori',
    product: 'Procuro',
    href: '/soluzioni/procuro/',
    context: 'Consegne di oggi — 5 ordini previsti',
    status: 'Stato: 3/5 completati',
    alert: {
      time: 'Oggi, 11:30',
      text: 'Consegna ortofrutta registrata con difformità: segnalati 2 colli mancanti al fornitore.',
      initials: 'EP',
    },
    cards: [
      {
        title: 'Pesce Fresco del Tirreno',
        category: 'Pescheria',
        status: 'Consegnato ore 08:45',
        tone: 'active',
        meta: '8 casse · temperatura controllata',
        image: photo('1534422298391-e4f8c172dddb'),
        imageAlt: 'Banchi del mercato del pesce con pescato fresco',
      },
      {
        title: 'Ortofrutta di Stagione',
        category: 'Ortofrutta',
        status: 'Parziale: -2 colli',
        tone: 'attention',
        meta: '12 casse · bolla n. 1042',
        image: photo('1610348725531-843dff563e2c'),
        imageAlt: 'Verdure fresche disposte in cassette di legno',
      },
      {
        title: 'Latticini e Formaggi Tipici',
        category: 'Latticini',
        status: 'Confermato',
        tone: 'active',
        meta: '4 referenze · consegna settimanale',
        image: photo('1486297678162-eb2a19b0a32d'),
        imageAlt: 'Formaggi freschi su un tagliere',
      },
      {
        title: 'Farine Speciali per Pizza',
        category: 'Dispensa',
        status: 'Riordino consigliato',
        tone: 'neutral',
        meta: '3 referenze · scorta sotto soglia',
        image: photo('1586528116311-ad8dd3c8310d'),
        imageAlt: 'Sacchi di farina nella dispensa',
      },
    ],
    actions: [
      { label: 'Nuovo ordine', icon: 'plus' },
      { label: 'Confronta listini', icon: 'arrow-left-right' },
