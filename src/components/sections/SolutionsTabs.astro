    contextCaption: 'Gestione acquisti merci, riordini e fornitori',
  },
  {
    id: 'wine',
    label: 'Cantina Digitale',
    product: 'Wine',
    href: '/soluzioni/wine/',
    context: 'Cantina principale — 428 etichette',
    status: 'Stato: Inventario aggiornato',
    alert: {
      time: 'Oggi, 18:20',
      text: 'Movimento registrato: 2 bottiglie di Barolo Riserva 2016 uscite per il servizio serale.',
      initials: 'LS',
    },
    cards: [
      {
        title: 'Barolo Riserva 2016',
        category: 'Rossi',
        status: 'Giacenza in calo',
        tone: 'attention',
        meta: '12 bottiglie · Cantina A · 2026–2036',
        image: photo('1506377247377-2a5b3b417ebb'),
        imageAlt: 'Bottiglie di vino in una cantina',
      },
      {
        title: 'Franciacorta Satèn Brut',
        category: 'Bollicine',
        status: 'Disponibile',
        tone: 'active',
        meta: '34 bottiglie · Cantina B · servire a 8 °C',
        image: photo('1560512823-829485b8bf24'),
        imageAlt: 'Calici di vino spumante bianco',
      },
      {
        title: 'Gewürztraminer 2022',
        category: 'Bianchi',
        status: 'Disponibile',
        tone: 'active',
        meta: '21 bottiglie · Cantina A · servire a 10 °C',
        image: photo('1516594915697-87eb3b1c14ea'),
        imageAlt: 'Bottiglie di vino bianco in cantina',
      },
      {
        title: 'Passito di Pantelleria DOC',
        category: 'Dolci',
        status: 'Riordino consigliato',
        tone: 'neutral',
        meta: '6 bottiglie · Cantina C · 2024–2030',
        image: photo('1474722883778-792e7990302f'),
        imageAlt: 'Vino dolce versato in un calice',
      },
    ],
    actions: [
      { label: 'Registra movimento', icon: 'arrow-up-down' },
      { label: 'Apri inventario', icon: 'archive' },
    ],
    detailsLabel: 'Vedi dettagli SeasonsJob Wine',
    contextCaption: 'Carta dei vini digitale e inventario cantina',
  },
];

/** Tab open on first render, and the one rendered visible in the static HTML. */
const ACTIVE_BY_DEFAULT: TabId = 'comande';

const tabId = (id: TabId): string => `soluzioni-tab-${id}`;
const panelId = (id: TabId): string => `soluzioni-panel-${id}`;
---

<div class="mt-8 sm:mt-10" data-solutions-tabs>
  <!-- Compact tab rail; on mobile the edge affordance makes horizontal scrolling discoverable. -->
  <div class="flex justify-center px-4">
    <div class="relative w-full sm:w-auto">
      <div
        role="tablist"
        aria-label="Soluzioni SeasonsJob"
        data-tabs-scroll
        class="no-scrollbar inline-flex w-full max-w-full items-center justify-start gap-1 overflow-x-auto rounded-2xl border border-neutral-200/80 bg-white/80 p-1.5 pr-11 shadow-2xs backdrop-blur-xs sm:w-auto sm:justify-center sm:pr-1.5"
      >
        {TABS.map((tab) => (
          <button
            type="button"
            role="tab"
            id={tabId(tab.id)}
            aria-selected={tab.id === ACTIVE_BY_DEFAULT ? 'true' : 'false'}
            aria-controls={panelId(tab.id)}
            tabindex={tab.id === ACTIVE_BY_DEFAULT ? 0 : -1}
            data-tab-target={tab.id}
            class:list={[
              'inline-flex shrink-0 cursor-pointer items-center rounded-xl px-3.5 py-1.5 text-xs font-semibold tracking-wide whitespace-nowrap transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900 sm:px-4 sm:py-2 sm:text-sm',
              tab.id === ACTIVE_BY_DEFAULT
                ? 'bg-[#333333] text-white'
                : 'text-neutral-600 hover:bg-neutral-100 hover:text-ink',
            ]}
          >
            {tab.label}
          </button>
        ))}
      </div>
      <div
        data-tab-scroll-hint
        class="pointer-events-none absolute inset-y-1.5 right-1.5 flex items-center rounded-r-xl bg-gradient-to-l from-white via-white/95 to-transparent pl-5 pr-1 text-neutral-500 sm:hidden"
        aria-hidden="true"
      >
        <span class="flex items-center gap-0.5 rounded-md bg-[#333333] px-1.5 py-1 text-[11px] font-semibold whitespace-nowrap text-white shadow-2xs">
          Scorri
          <Icon name="arrow-right" class="size-3.5" />
        </span>
      </div>
    </div>
  </div>

  <!-- Tablet mockup: authentic iPad chassis with generous, perfectly identical borders on all 4 sides -->
  <div class="relative mx-auto mt-7 max-w-4xl rounded-[2.25rem] border border-neutral-800/90 bg-[#121614] p-4.5 shadow-[0_25px_60px_-20px_rgba(0,0,0,0.38)] ring-1 ring-white/10 sm:mt-9 sm:rounded-[2.75rem] sm:p-6">
    <!-- Tablet camera pinhole absolutely centered in top bezel (zero flow impact) -->
    <div
      class="pointer-events-none absolute top-1.5 left-1/2 flex -translate-x-1/2 items-center justify-center gap-1.5 sm:top-2.5"
      aria-hidden="true"
    >
      <span class="size-1.5 rounded-full bg-neutral-700/80"></span>
      <span class="h-1 w-6 rounded-full bg-neutral-800"></span>
    </div>

    {TABS.map((tab) => (
      <div
        id={panelId(tab.id)}
        role="tabpanel"
        aria-labelledby={tabId(tab.id)}
        data-tab-panel={tab.id}
        class:list={[
          tab.id !== ACTIVE_BY_DEFAULT && 'hidden',
          'md:h-[620px] lg:h-[640px]',
        ]}
      >
        {tab.id === 'comande' ? (
          /* =======================================================
               AUTHENTIC SEASONSJOB COMANDE IPAD APP UI (COMPACT)
               ======================================================= */
          <div class="flex h-full flex-col overflow-hidden rounded-[1.5rem] bg-[#f7f9f8] shadow-xs">
            {/* Top Green App Header */}
            <div class="flex shrink-0 items-center justify-between bg-[#205a36] px-3.5 py-2.5 text-white sm:px-5 sm:py-3">
              <div class="flex items-center gap-2 sm:gap-3">
                <span class="grid size-6.5 place-items-center rounded-lg bg-white/10 transition-colors">
                  <svg
                    class="size-3.5 sm:size-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="19" y1="12" x2="5" y2="12" />
                    <polyline points="12 19 5 12 12 5" />
                  </svg>
                </span>
                <span class="text-xs font-bold tracking-tight sm:text-sm">
                  Info Comanda
                </span>
                <svg
                  class="size-4 opacity-80 sm:size-4.5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M12 4a1 1 0 0 1 1 1v1a8 8 0 0 1 8 8v1H3v-1a8 8 0 0 1 8-8V5a1 1 0 0 1 1-1z" />
                  <path d="M2 17h20" />
                </svg>
              </div>

              <div class="flex items-center gap-2 sm:gap-3.5">
                <span class="flex items-center gap-1.5 text-xs font-semibold tracking-wide">
                  <svg
                    class="size-3.5 opacity-85"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect
                      x="3"
                      y="4"
                      width="18"
                      height="18"
                      rx="2"
                      ry="2"
                      stroke-width="2"
                    />
                    <line x1="16" y1="2" x2="16" y2="6" />
                    <line x1="8" y1="2" x2="8" y2="6" />
                    <line x1="3" y1="10" x2="21" y2="10" />
                  </svg>
                  08 SET
                </span>
                <span class="inline-flex items-center gap-1.5 rounded-full border border-white/25 bg-white/15 px-2 py-0.5 text-[10px] font-bold tracking-wider text-white uppercase shadow-2xs sm:text-[11px]">
                  <svg
                    class="size-2.5 text-amber-300"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <circle cx="12" cy="12" r="4" />
                    <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
                  </svg>
                  PRANZO
                </span>
              </div>
            </div>

            {/* App Body Content */}
            <div class="min-h-0 flex-1 space-y-3.5 overflow-y-auto p-3.5 sm:space-y-4 sm:p-5 lg:p-6">
              {/* Comanda Modifica Title Row */}
              <div class="flex items-center justify-between gap-3">
                <div>
                  <span class="flex items-center gap-1.5 text-[10px] font-bold tracking-widest text-neutral-400 uppercase sm:text-[11px]">
                    <svg
                      class="size-3"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                      <polyline points="14 2 14 8 20 8" />
                      <line x1="16" y1="13" x2="8" y2="13" />
                      <line x1="16" y1="17" x2="8" y2="17" />
                    </svg>
                    COMANDA
                  </span>
                  <h3 class="mt-0.5 text-xl font-extrabold tracking-tight text-neutral-900 sm:text-2xl">
                    Modifica #1596
                  </h3>
                </div>

                <div class="flex items-center gap-1.5 rounded-full border border-amber-300/80 bg-[#fffdf0] px-3 py-1 text-xs font-bold text-amber-900 shadow-2xs">
                  <svg
                    class="size-3 text-amber-600 sm:size-3.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <circle cx="12" cy="12" r="4" />
                    <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
                  </svg>
                  <span>Pranzo</span>
                </div>
              </div>

              {/* Course Title + Add Button */}
              <div class="flex items-center justify-between pt-0.5">
                <div class="flex items-center gap-2 text-xs font-extrabold tracking-wider text-neutral-900 uppercase sm:text-sm">
                  <svg
                    class="size-4 text-neutral-800 sm:size-4.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M4 11a8 8 0 0 0 16 0H4z" />
                    <path d="M6 16h12" />
                    <path d="M9 4v3m3-4v3m3-4v3" />
                  </svg>
                  <span>PRIMA PORTATA</span>
                </div>

                <button
                  type="button"
                  class="flex cursor-pointer items-center gap-1.5 rounded-lg bg-[#205a36] px-3 py-1.5 text-xs font-bold text-white shadow-2xs transition-colors hover:bg-[#1a4a2c]"
                >
                  <svg
                    class="size-3"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="5" x2="12" y2="19" />
                    <line x1="5" y1="12" x2="19" y2="12" />
                  </svg>
                  <span>Aggiungi</span>
                </button>
              </div>

              {/* Dish Cards List */}
              <div class="space-y-2.5 sm:space-y-3">
                {COMANDE_DISHES.map((dish) => (
                  <div class="flex flex-col justify-between gap-3 rounded-xl border border-neutral-200/90 bg-white p-3 shadow-2xs transition-all hover:border-neutral-300 sm:flex-row sm:items-center sm:p-4">
                    <div class="flex flex-col">
                      <h4 class="text-sm font-bold leading-snug text-neutral-900 sm:text-[0.9375rem]">
                        {dish.title}
                      </h4>
                      <p class="mt-0.5 flex items-center gap-1.5 text-xs font-medium text-neutral-500">
                        <span class="text-xs leading-none" aria-hidden="true">
                          🇬🇧
                        </span>
                        <span>{dish.en}</span>
                      </p>
                      <p class="mt-0.5 flex items-center gap-1.5 text-xs font-medium text-neutral-500">
                        <span class="text-xs leading-none" aria-hidden="true">
                          🇩🇪
                        </span>
                        <span>{dish.de}</span>
                      </p>
                      <div class="mt-1.5">
                        {dish.hasActiveNote ? (
                          <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-[#2563eb]">
                            <svg
                              class="size-3"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            >
                              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                              <polyline points="14 2 14 8 20 8" />
                              <line x1="16" y1="13" x2="8" y2="13" />
                            </svg>
                            Aggiungi note
                          </span>
                        ) : (
                          <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-neutral-400">
                            <svg
                              class="size-3"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            >
                              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                              <polyline points="14 2 14 8 20 8" />
                              <line x1="16" y1="13" x2="8" y2="13" />
                            </svg>
                            Aggiungi note
                          </span>
                        )}
                      </div>
                    </div>

                    {/* Stepper Counter */}
                    <div class="stepper-container flex items-center justify-end self-end sm:self-center">
                      <div class="flex items-center gap-2.5 rounded-xl border border-neutral-200/70 bg-neutral-50/70 p-1 sm:gap-3.5">
                        <button
                          type="button"
                          data-stepper-btn="minus"
                          aria-label={`Riduci quantità per ${dish.title}`}
                          class="size-9 cursor-pointer rounded-lg border border-amber-200/70 bg-[#fffdf0] text-xl font-bold text-amber-900 shadow-2xs transition-colors hover:bg-amber-100/70 sm:size-10"
                        >
                          −
                        </button>
                        <span
                          data-stepper-value
                          class="w-6 text-center text-lg font-black text-neutral-900 sm:w-8 sm:text-2xl"
                        >
                          {dish.count}
                        </span>
                        <button
                          type="button"
                          data-stepper-btn="plus"
                          aria-label={`Aumenta quantità per ${dish.title}`}
                          class="size-9 cursor-pointer rounded-lg bg-[#fbb01b] text-xl font-black text-neutral-950 shadow-xs transition-colors hover:bg-[#f5a70f] sm:size-10"
                        >
                          +
                        </button>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            {/* Bottom Tablet App Navigation Bar */}
            <div class="mt-auto grid shrink-0 grid-cols-3 items-center border-t border-neutral-200/90 bg-white px-3 py-1.5 sm:px-5 sm:py-2">
              <button
                type="button"
