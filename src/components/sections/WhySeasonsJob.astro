---
/*
  "Perché SeasonsJob" section.
  Dark section with a bento grid of light cards and UI fragments
  showcasing sector-focused product principles.
*/
---

<section
  id="perche-seasonsjob"
  class="relative overflow-hidden bg-[#141816] text-white"
>
  {/* Ambient emerald background glows */}
  <div
    class="pointer-events-none absolute inset-x-0 -top-24 h-72 bg-[radial-gradient(ellipse_60%_50%_at_50%_0%,rgba(7,134,96,0.22),transparent_70%)]"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute inset-x-0 -bottom-24 h-72 bg-[radial-gradient(ellipse_60%_50%_at_50%_100%,rgba(7,134,96,0.15),transparent_70%)]"
    aria-hidden="true"
  ></div>

  <div class="relative z-10 mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-24">
    {/* Section Header */}
    <div class="mx-auto flex max-w-3xl flex-col items-center text-center">
      <p class="eyebrow text-neutral-400" data-reveal="fade">
        <span
          class="size-1.5 rounded-[2px] bg-brand-400"
          aria-hidden="true"
        ></span>
        Perché SeasonsJob
      </p>
      <h2
        class="font-display mt-4 text-[2rem] leading-[1.15] text-white sm:text-[2.5rem] md:text-[2.875rem]"
        data-reveal="title"
      >
        Un modo di fare software{' '}
        <em class="font-display font-normal text-brand-300 italic">
          vicino a chi lo usa
        </em>
      </h2>

      <p
        class="mt-4 max-w-2xl text-lg leading-relaxed text-neutral-300"
        data-reveal
        data-reveal-delay="1"
      >
        Strumenti separati per ogni reparto, costruiti con chi li usa in sala,
        in cucina, in cantina.
      </p>
    </div>

    {/* 3-Column Asymmetric Bento Grid - light cards on dark section */}
    <div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 sm:mt-16">
      {/* ================= COLUMN 1 ================= */}
      <div class="flex flex-col gap-6">
        {/* Card 1 (Taller): Nati dai flussi reali */}
        <div
          data-reveal="scale"
          class="flex flex-col justify-between rounded-2xl bg-white p-6 sm:p-7 shadow-lg ring-1 ring-white/10 transition-all hover:-translate-y-0.5 hover:shadow-xl"
        >
          {/* Visual: Floating notification & service prompt */}
          <div class="relative mb-8 flex min-h-[210px] items-center justify-center overflow-hidden rounded-xl border border-neutral-200/80 bg-neutral-50 p-4">
            <div class="w-full max-w-[270px] space-y-3">
              <div class="flex items-center justify-between text-[0.6875rem] font-semibold tracking-wider text-neutral-500 uppercase">
                <span>Servizio di sala</span>
                <span class="inline-flex items-center gap-1 text-brand-600">
                  <span class="size-1.5 rounded-full bg-brand-500 animate-pulse"></span>
                  In corso
                </span>
              </div>

              {/* Incoming request bubble */}
              <div class="why-msg rounded-xl border border-neutral-200 bg-white px-3.5 py-2.5 text-xs text-neutral-800 shadow-sm">
                <p class="font-medium leading-snug">
                  Tavolo 14: 2 risotti alla zucca senza glutine e anticipo
                  secondi
                </p>
              </div>

              {/* System action confirmation */}
              <div class="why-confirm rounded-xl border border-brand-500/30 bg-brand-50 p-3 text-[0.75rem] text-brand-800">
                <p class="flex items-center gap-1.5 font-semibold text-brand-700">
                  <svg
                    class="size-3.5 shrink-0 text-brand-600"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  Comanda aggiornata in cucina
                </p>
                <p class="mt-0.5 text-[0.6875rem] text-brand-700/80">
                  Allergene segnalato · timer sincronizzato
                </p>
              </div>
            </div>
          </div>

          <div>
            <h3 class="text-lg font-semibold text-neutral-900">
              Nati dai flussi reali
            </h3>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-[#626765]">
              Partiamo da come si lavora in reception, in sala, in cucina e in
              cantina.
            </p>
          </div>
        </div>

        {/* Card 2 (Shorter): Solo settore alberghiero */}
        <div
          data-reveal="scale"
          class="flex flex-col justify-between rounded-2xl bg-white p-6 sm:p-7 shadow-lg ring-1 ring-white/10 transition-all hover:-translate-y-0.5 hover:shadow-xl"
        >
          {/* Visual: Overlapping sector badges */}
          <div class="relative mb-8 flex min-h-[170px] items-center justify-center overflow-hidden rounded-xl border border-neutral-200/80 bg-neutral-50 p-4">
            <div class="relative flex items-center justify-center">
              {/* Document 1: HACCP */}
              <div class="why-float relative z-0 -mr-4 -rotate-6 rounded-xl border border-neutral-200 bg-white p-4 shadow-sm">
                <span class="block text-xs font-bold tracking-wider text-rose-600 uppercase">
                  HACCP
                </span>
                <span class="mt-1 block text-[0.6875rem] text-neutral-500">
                  Tracciabilità lotti
                </span>
              </div>

              {/* Document 2: Turni */}
              <div class="why-float relative z-10 rotate-3 [animation-delay:-1.3s] rounded-xl border border-brand-500/40 bg-brand-50 p-4 shadow-md">
                <span class="block text-xs font-bold tracking-wider text-brand-600 uppercase">
                  CCNL
                </span>
                <span class="mt-1 block text-[0.6875rem] text-neutral-800 font-medium">
                  Extra & Stagionali
                </span>
              </div>

              {/* Document 3: Cantina */}
              <div class="why-float relative z-0 -ml-4 rotate-12 [animation-delay:-2.6s] rounded-xl border border-neutral-200 bg-white p-4 shadow-sm">
                <span class="block text-xs font-bold tracking-wider text-amber-600 uppercase">
                  WINE
                </span>
                <span class="mt-1 block text-[0.6875rem] text-neutral-500">
                  428 referenze
                </span>
              </div>
            </div>
          </div>

          <div>
            <h3 class="text-lg font-semibold text-neutral-900">
              Solo settore alberghiero
            </h3>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-[#626765]">
              Lavoriamo solo con hotel e ristoranti: stagionalità, turni
              spezzati, fornitori locali, ritmi del servizio.
            </p>
          </div>
        </div>
      </div>

      {/* ================= COLUMN 2 ================= */}
      <div class="flex flex-col gap-6">
        {/* Card 3 (Shorter): Pratici, zero formazione */}
        <div
          data-reveal="scale"
          data-reveal-delay="1"
          class="flex flex-col justify-between rounded-2xl bg-white p-6 sm:p-7 shadow-lg ring-1 ring-white/10 transition-all hover:-translate-y-0.5 hover:shadow-xl"
        >
          {/* Visual: one big action, one tap */}
          <div class="relative mb-8 flex min-h-[170px] items-center justify-center overflow-hidden rounded-xl border border-neutral-200/80 bg-neutral-50 p-4">
            <div class="w-full max-w-[220px] rounded-xl border border-neutral-200 bg-white p-3 shadow-sm">
              <div class="flex items-center justify-between text-[0.6875rem] text-neutral-500">
                <span class="font-semibold text-neutral-800">
                  Turno di sera
                </span>
                <span>18:00 – 23:30</span>
              </div>

              <div class="relative mt-3">
                <div class="flex items-center justify-center gap-2 rounded-lg bg-brand-500 py-3 text-sm font-semibold text-white">
                  <svg
                    class="size-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  Inizia turno
                </div>
                {/* Tap indicator */}
                <span
                  class="absolute right-6 -bottom-3 grid place-items-center"
                  aria-hidden="true"
                >
                  <span class="absolute size-8 rounded-full bg-brand-500/25 motion-safe:animate-ping"></span>
                  <span class="relative size-4 rounded-full border-2 border-neutral-800 bg-white/70 shadow-md"></span>
                </span>
              </div>

              <div class="mt-4 flex items-center justify-between text-[0.6875rem] text-neutral-500">
                <span>Un tocco, niente menu</span>
                <span class="flex gap-1" aria-hidden="true">
                  <span class="size-1.5 rounded-full bg-brand-500"></span>
                  <span class="size-1.5 rounded-full bg-neutral-200"></span>
                  <span class="size-1.5 rounded-full bg-neutral-200"></span>
                </span>
              </div>
            </div>
          </div>

          <div>
            <h3 class="text-lg font-semibold text-neutral-900">
              Pratici, zero formazione
            </h3>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-[#626765]">
              Poche funzioni chiare, senza decine di opzioni che nessuno apre.
              Il personale li usa da subito, senza manuali.
            </p>
          </div>
        </div>

        {/* Card 4 (Taller): Workflow Automation / Ecosistema integrato */}
        <div
          data-reveal="scale"
          data-reveal-delay="1"
          class="flex flex-col justify-between rounded-2xl bg-white p-6 sm:p-7 shadow-lg ring-1 ring-white/10 transition-all hover:-translate-y-0.5 hover:shadow-xl"
        >
          {/* Visual: Connected Node Flow Diagram */}
          <div class="relative mb-8 flex min-h-[210px] flex-col items-center justify-center overflow-hidden rounded-xl border border-neutral-200/80 bg-neutral-50 p-4">
            {/* Top trigger pill */}
            <div class="inline-flex items-center gap-2 rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs font-semibold text-neutral-800 shadow-xs">
              <span class="text-amber-600">⚡</span>
              <span>Trigger: Comanda chiusa</span>
            </div>

            {/* Connecting dashed line */}
            <div class="why-flow-y h-5 w-0.5"></div>

            {/* Central node cluster */}
            <div class="flex items-center gap-3">
              <span class="why-glow grid size-9 place-items-center rounded-xl bg-brand-500 text-xs font-bold text-white shadow-sm">
                S
              </span>
              <span class="why-flow-x h-0.5 w-4"></span>
              <span class="inline-flex items-center gap-1.5 rounded-lg border border-neutral-200 bg-white px-2.5 py-1 text-[0.6875rem] font-medium text-neutral-600 shadow-xs">
                <span>Scarico bottiglie</span>
              </span>
            </div>

            {/* Connecting dashed line */}
            <div class="why-flow-y h-5 w-0.5"></div>

            {/* Bottom action pill */}
            <div class="inline-flex items-center gap-2 rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs font-semibold text-neutral-800 shadow-xs">
              <span class="text-brand-600">✓</span>
              <span>Azione: Riconciliazione inventario</span>
            </div>
          </div>

          <div>
            <h3 class="text-lg font-semibold text-neutral-900">
              Ecosistema integrato
            </h3>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-[#626765]">
              Tavoli, acquisti, inventario: le informazioni passano da un
              reparto all'altro senza fogli sparsi o telefonate.
            </p>
          </div>
        </div>
      </div>

      {/* ================= COLUMN 3 ================= */}
      <div class="flex flex-col gap-6 md:col-span-2 lg:col-span-1">
        {/* Card 5 (Taller): Controllo immediato / Ricerca istantanea */}
        <div
          data-reveal="scale"
          data-reveal-delay="2"
          class="flex flex-col justify-between rounded-2xl bg-white p-6 sm:p-7 shadow-lg ring-1 ring-white/10 transition-all hover:-translate-y-0.5 hover:shadow-xl"
        >
          {/* Visual: Search bar with floating contextual tags */}
          <div class="relative mb-8 flex min-h-[210px] flex-col items-center justify-center overflow-hidden rounded-xl border border-neutral-200/80 bg-neutral-50 p-4">
            {/* Search Input Bar */}
            <div class="flex w-full items-center gap-2 rounded-xl border border-neutral-200 bg-white px-3 py-2 text-xs text-neutral-600 shadow-xs">
              <svg
                class="size-3.5 shrink-0 text-neutral-500"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <span>Cerca comanda, turno o fornitore...</span>
              <span
                class="why-caret -ml-1.5 h-3.5 w-px bg-neutral-800"
                aria-hidden="true"
              ></span>
            </div>

            {/* Floating Tags */}
            <div class="mt-4 flex flex-wrap justify-center gap-2">
              <span class="rounded-full border border-neutral-200 bg-white px-2.5 py-1 text-[0.6875rem] font-medium text-neutral-600 shadow-xs">
                Turno Sous Chef (Venerdì)
              </span>
              <span class="why-glow rounded-full border border-brand-500/40 bg-brand-50 px-2.5 py-1 text-[0.6875rem] font-medium text-brand-700 shadow-xs">
                Tavolo 14 · Sala Veranda
              </span>
              <span class="rounded-full border border-neutral-200 bg-white px-2.5 py-1 text-[0.6875rem] font-medium text-neutral-600 shadow-xs">
                Barolo Riserva 2016
              </span>
              <span class="rounded-full border border-neutral-200 bg-white px-2.5 py-1 text-[0.6875rem] font-medium text-neutral-600 shadow-xs">
                Ordine Ortofrutta Bio
              </span>
            </div>
          </div>

          <div>
            <h3 class="text-lg font-semibold text-neutral-900">
              Controllo immediato
            </h3>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-[#626765]">
              Vedi turni, comande e fornitori mentre stai lavorando. Così
              intervieni subito, anche nel pieno del servizio.
            </p>
          </div>
        </div>

        {/* Card 6 (Shorter): Crescono con le strutture */}
        <div
          data-reveal="scale"
          data-reveal-delay="2"
          class="flex flex-col justify-between rounded-2xl bg-white p-6 sm:p-7 shadow-lg ring-1 ring-white/10 transition-all hover:-translate-y-0.5 hover:shadow-xl"
        >
          {/* Visual: Performance Analytics Curve */}
          <div class="relative mb-8 flex min-h-[170px] items-center justify-center overflow-hidden rounded-xl border border-neutral-200/80 bg-neutral-50 p-4">
            <div class="relative w-full max-w-[220px]">
              {/* Upward trending SVG curve */}
              <svg
                class="h-16 w-full overflow-visible"
                viewBox="0 0 200 60"
                fill="none"
              >
                <defs>
                  <linearGradient
                    id="curveGradientLight"
                    x1="0"
                    y1="0"
                    x2="0"
                    y2="1"
                  >
                    <stop offset="0%" stop-color="#078660" stop-opacity="0.3" />
                    <stop
                      offset="100%"
                      stop-color="#078660"
                      stop-opacity="0.0"
                    />
                  </linearGradient>
                </defs>
                <path
                  d="M 0 50 Q 50 45 100 25 T 200 5 L 200 60 L 0 60 Z"
                  fill="url(#curveGradientLight)"
                />
                <path
                  d="M 0 50 Q 50 45 100 25 T 200 5"
                  pathLength="1"
                  class="why-draw"
                  stroke="#078660"
                  stroke-width="2.5"
                  stroke-linecap="round"
                />
              </svg>

              {/* Floating Stat Pill */}
              <div class="mt-2 flex items-center justify-between text-[0.6875rem] text-neutral-500">
                <span class="font-medium">Tempo risparmiato</span>
                <span class="font-semibold text-brand-600">+35% / turno</span>
              </div>
            </div>
          </div>

          <div>
            <h3 class="text-lg font-semibold text-neutral-900">
              Crescono con le strutture
            </h3>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-[#626765]">
              Miglioriamo gli strumenti partendo da quello che ci chiedono le
              strutture dove lavoriamo.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Ambient card loops on small elements, disabled under reduced motion */
  .why-flow-y,
  .why-flow-x {
    background: repeating-linear-gradient(
      var(--dir, 180deg),
      var(--color-neutral-300) 0 4px,
      transparent 4px 8px
    );
    background-size: 100% 16px;
  }
  .why-flow-x {
    --dir: 90deg;
    background-size: 16px 100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .why-msg {
      animation: why-msg 6s ease-out infinite;
    }
    .why-confirm {
      animation: why-confirm 6s ease-out infinite;
    }
    .why-float {
      animation: why-float 4s ease-in-out infinite;
    }
    .why-flow-y {
      animation: why-flow-y 1s linear infinite;
    }
    .why-flow-x {
      animation: why-flow-x 1s linear infinite;
    }
    .why-glow {
      animation: why-glow 2.4s ease-in-out infinite;
    }
    .why-caret {
      animation: why-caret 1s steps(1) infinite;
    }
    .why-draw {
      stroke-dasharray: 1;
      animation: why-draw 5s ease-out infinite;
    }
  }

  @keyframes why-msg {
    0% {
      opacity: 0;
      translate: 0 8px;
    }
    10%,
    90% {
      opacity: 1;
      translate: 0 0;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes why-confirm {
    0%,
    25% {
      opacity: 0;
      scale: 0.96;
    }
    35%,
    90% {
      opacity: 1;
      scale: 1;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes why-float {
    50% {
      translate: 0 -6px;
    }
  }
  @keyframes why-flow-y {
    to {
      background-position: 0 16px;
    }
  }
  @keyframes why-flow-x {
    to {
      background-position: 16px 0;
    }
  }
  @keyframes why-glow {
    50% {
      box-shadow: 0 0 0 6px rgb(7 134 96 / 0.15);
    }
  }
  @keyframes why-caret {
    50% {
      opacity: 0;
    }
  }
  @keyframes why-draw {
    0% {
      stroke-dashoffset: 1;
    }
    40%,
    100% {
      stroke-dashoffset: 0;
    }
  }
</style>
