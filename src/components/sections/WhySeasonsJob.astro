---
import Icon from '@/components/ui/Icon.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';

/*
  Principles behind the products — company positioning, not product features.
  The single dark section of the page gives the homepage its second rhythm.
*/
const PRINCIPLES = [
  {
    title: 'Nati dai flussi reali',
    text: 'Partiamo da come si lavora davvero in reception, in sala, in cucina e in cantina, non da uno schema astratto.',
  },
  {
    title: 'Progettati con chi li usa',
    text: 'I prodotti prendono forma a contatto con le persone che li useranno ogni giorno, e cambiano con il loro riscontro.',
  },
  {
    title: 'Pratici, non complicati',
    text: 'Poche funzioni chiare al posto di tante opzioni inutili. Si capiscono in fretta e si usano senza formazione lunga.',
  },
  {
    title: 'Solo hospitality',
    text: 'Non facciamo software per tutti i settori. Conosciamo stagioni, turni, fornitori e ritmi di una struttura ricettiva.',
  },
  {
    title: 'Crescono con le esigenze',
    text: 'Ogni prodotto evolve seguendo bisogni operativi concreti, non un elenco di funzionalità da vendere.',
  },
];
---

<section class="bg-night">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-24">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5" data-reveal>
        <SectionHeader
          tone="dark"
          eyebrow="Perché SeasonsJob"
          title="Un modo di fare software vicino a chi lo usa"
          description="Non vendiamo una piattaforma da adattare. Costruiamo strumenti specifici, uno per volta, con le strutture che li adottano."
        />
        <a
          href="/chi-siamo/"
          class="mt-8 inline-flex items-center gap-1.5 py-1.5 text-[0.9375rem] font-medium text-brand-300 transition-colors hover:text-brand-200"
        >
          Chi siamo
          <Icon name="arrow-right" class="size-4" />
        </a>
      </div>

      <dl
        class="divide-y divide-white/10 border-t border-white/10 lg:col-span-7"
        data-reveal
      >
        {PRINCIPLES.map((principle, i) => (
          <div class="py-7">
            <dt class="flex items-baseline gap-3">
              <span
                class="font-display w-9 shrink-0 text-xl text-brand-300 tabular-nums"
                aria-hidden="true"
              >
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="text-xl font-semibold text-white">
                {principle.title}
              </span>
            </dt>
            <dd class="mt-2 max-w-prose leading-relaxed text-neutral-400 sm:pl-12">
              {principle.text}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
