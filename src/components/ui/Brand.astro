---
interface Props {
  /** Wordmark size; `md` is used in the header, `sm` in the footer. */
  size?: 'sm' | 'md';
  class?: string;
}

const { size = 'md', class: className } = Astro.props;

const words = {
  sm: 'text-base',
  md: 'text-[1.25rem]',
};
---

<a
  href="/"
  class:list={['inline-flex items-center gap-2.5 rounded-lg', className]}
  aria-label="SeasonsJob — home"
>
  <span
    class="font-display grid size-8.5 place-items-center rounded-lg bg-brand-500 text-[1.125rem] font-black text-white leading-none shadow-2xs"
    aria-hidden="true"
  >
    S
  </span>
  <span
    class:list={[
      'font-display font-black tracking-tight text-ink',
      words[size],
    ]}
  >
    SeasonsJob
  </span>
</a>
