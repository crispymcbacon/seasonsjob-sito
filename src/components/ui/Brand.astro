---
interface Props {
  /** Wordmark size; `md` is used in the header, `sm` in the footer. */
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { size = 'md', class: className } = Astro.props;

const words = {
  sm: 'text-base',
  md: 'text-[1.25rem]',
  lg: 'text-[1.5rem]',
};

const marks = {
  sm: 'size-8.5 text-[1.125rem]',
  md: 'size-8.5 text-[1.125rem]',
  lg: 'size-10 text-[1.3rem]',
};
---

<a
  href="/"
  class:list={['inline-flex items-center gap-2.5 rounded-lg', className]}
  aria-label="SeasonsJob — home"
>
  <span
    class:list={[
      'font-display grid place-items-center rounded-lg bg-brand-500 font-black text-white leading-none shadow-2xs',
      marks[size],
    ]}
    aria-hidden="true"
  >
    S
  </span>
  <span
    class:list={[
      'font-display font-black tracking-tight text-ink',
      words[size],
    ]}
  >
    SeasonsJob
  </span>
</a>
