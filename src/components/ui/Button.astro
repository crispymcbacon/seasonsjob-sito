---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'inverted' | 'inverted-secondary';
  /** `lg` is used for the closing CTA, `md` everywhere else. */
  size?: 'md' | 'lg';
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className,
} = Astro.props;

const variants = {
  primary: 'bg-[#333333] text-white hover:bg-[#1f1f1f]',
  secondary:
    'border border-neutral-300 bg-white text-ink hover:border-neutral-400 hover:bg-neutral-50',
  inverted: 'bg-white text-ink hover:bg-neutral-100 shadow-sm',
  'inverted-secondary':
    'border border-white/20 bg-white/10 text-white hover:bg-white/20 backdrop-blur-xs',
};

const sizes = {
  md: 'min-h-11 px-5 text-[0.9375rem]',
  lg: 'min-h-12 px-6 text-base',
};
---

<a
  href={href}
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-lg font-medium transition-colors',
    // Keep the keyboard focus ring visible on light backgrounds, where the
    // inherited `currentColor` ring would disappear on the primary button.
    'focus-visible:outline-ink',
    variants[variant],
    sizes[size],
    className,
  ]}
>
  <slot />
</a>
