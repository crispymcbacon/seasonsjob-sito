---
// Minimal building block for placeholder routes only.
// Will be deleted when real sections are designed.
import Button from './Button.astro';
import Icon from './Icon.astro';
import SectionHeader from './SectionHeader.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Pagina segnaposto.' } = Astro.props;
---

<section>
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-28">
    <div class="max-w-2xl">
      <SectionHeader
        eyebrow="In preparazione"
        level="h1"
        title={title}
        description={description}
      />

      <div class="mt-10">
        <Button href="/">
          Torna alla home
          <Icon name="arrow-right" class="size-4" />
        </Button>
      </div>
    </div>
  </div>
</section>
