---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  /** `dark` is for use on the selected dark section. */
  tone?: 'light' | 'dark';
  /** Heading level, so the document outline stays correct per page. */
  level?: 'h1' | 'h2' | 'h3';
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  tone = 'light',
  level = 'h2',
  class: className,
} = Astro.props;

const Heading = level;
---

<div class:list={['flex flex-col gap-5', className]}>
  {eyebrow && (
    <p
      class:list={[
        'eyebrow inline-flex items-center gap-2.5 text-lg font-medium text-[#777777]',
        tone === 'dark' && 'text-neutral-400',
      ]}
    >
      <span
        class:list={[
          'size-2 rounded-[2px]',
          tone === 'dark' ? 'bg-brand-400' : 'bg-brand-500',
        ]}
        aria-hidden="true"
      />
      {eyebrow}
    </p>
  )}
  <Heading
    class:list={[
      'text-[1.75rem] leading-[1.15] sm:text-[2.125rem] md:text-[2.5rem]',
      tone === 'dark' ? 'text-white' : 'text-ink',
    ]}
  >
    {title}
  </Heading>
  {description && (
    <p
      class:list={[
        'max-w-prose text-lg leading-relaxed',
        tone === 'dark' ? 'text-neutral-400' : 'text-neutral-600',
      ]}
    >
      {description}
    </p>
  )}
</div>
