---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  /** `dark` is for use on the selected dark section. */
  tone?: 'light' | 'dark';
  /** Heading level, so the document outline stays correct per page. */
  level?: 'h2' | 'h3';
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  tone = 'light',
  level = 'h2',
  class: className,
} = Astro.props;

const Heading = level;
---

<div class:list={['flex flex-col gap-4', className]}>
  {eyebrow && (
    <p
      class:list={[
        'flex items-center gap-2 text-xs font-semibold tracking-[0.14em] uppercase',
        tone === 'dark' ? 'text-brand-300' : 'text-brand-600',
      ]}
    >
      <span
        class:list={[
          'size-1.5 rounded-full',
          tone === 'dark' ? 'bg-brand-300' : 'bg-brand-500',
        ]}
        aria-hidden="true"
      />
      {eyebrow}
    </p>
  )}
  <Heading
    class:list={[
      'text-[1.75rem] sm:text-[2rem] lg:text-[2.25rem]',
      tone === 'dark' ? 'text-white' : 'text-ink',
    ]}
  >
    {title}
  </Heading>
  {description && (
    <p
      class:list={[
        'max-w-prose text-base leading-relaxed sm:text-[1.0625rem]',
        tone === 'dark' ? 'text-neutral-400' : 'text-neutral-600',
      ]}
    >
      {description}
    </p>
  )}
</div>
