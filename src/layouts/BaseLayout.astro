---
import { SITE } from '@/config/site';
import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import '../styles/global.css';

interface Props {
  /** Browser tab title; `${title} | SeasonsJob` unless it already contains the brand. */
  title: string;
  /** Meta description; falls back to the site-wide default. */
  description?: string;
  /** Canonical path (e.g. `/soluzioni/comande/`); defaults to the Astro pathname. */
  canonical?: string;
  /** OpenGraph type, `website` by default. */
  ogType?: 'website' | 'article';
  /** Optional OG image path relative to the site root. */
  ogImage?: string;
}

const {
  title,
  description = SITE.description,
  canonical,
  ogType = 'website',
  ogImage,
} = Astro.props;

// Canonical URL: explicit prop wins, otherwise derive from the current pathname.
const canonicalPath = canonical ?? Astro.url.pathname;
const canonicalUrl = new URL(canonicalPath, SITE.url).href;
const ogImageUrl = ogImage ? new URL(ogImage, SITE.url).href : undefined;
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- OpenGraph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

    <!-- Per-page additions (e.g. structured data on the homepage). -->
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a class="skip-link" href="#main">
      Vai al contenuto
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  /* Visually hidden until focused; announced to screen readers. */
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    background: white;
    color: black;
    padding: 0.5rem 1rem;
  }
  .skip-link:focus {
    left: 0.5rem;
    top: 0.5rem;
  }
</style>
