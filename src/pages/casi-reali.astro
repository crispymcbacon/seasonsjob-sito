---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import CaseModuleIcon from '@/components/ui/CaseModuleIcon.astro';
import CasePhotoFrame from '@/components/ui/CasePhotoFrame.astro';
import ContactCta from '@/components/sections/ContactCta.astro';
import { SITE } from '@/config/site';

const title = 'Casi reali';
const description =
  'Come hotel, ristoranti e taverne usano SeasonsJob ogni giorno: comande digitali, ordini ai fornitori e inventario della cantina, raccontati dalle strutture.';

const cases = (await getCollection('casi-reali')).sort(
  (a, b) => a.data.order - b.data.order,
);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: cases.map((entry, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: `${entry.data.facility} — ${entry.data.title}`,
    url: new URL(`/casi-reali/${entry.id}/`, SITE.url).href,
  })),
};
---

<BaseLayout title={title} description={description} canonical="/casi-reali/">
  <script
    type="application/ld+json"
    is:inline
    slot="head"
    set:html={JSON.stringify(structuredData)}
  ></script>
  {/* Page hero */}
  <section class="page-hero" aria-labelledby="page-title">
    <div class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6 lg:py-28">
      <p class="inline-flex items-center gap-2.5 text-base font-medium text-[#646a68]">
        <span
          class="size-[7px] rounded-[2px] bg-brand-500"
          aria-hidden="true"
        ></span>
        Casi reali
      </p>
      <h1
        id="page-title"
        class="mt-5 text-[clamp(2.2rem,4.5vw,3.25rem)] leading-[1.18] tracking-[-0.03em] text-ink"
      >
        SeasonsJob al lavoro{' '}
        <em class="font-normal text-brand-700 italic">nelle strutture</em>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-[#626765]">
        Hotel, ristoranti e taverne che usano i nostri strumenti ogni giorno:
        storie concrete di comande digitali, ordini ai fornitori e cantine sotto
        controllo.
      </p>
    </div>
  </section>

  {/* Showcase list: one large entry per case, linking to its detail page */}
  <section class="border-b border-neutral-200/80 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-24">
      <div class="flex flex-col gap-8">
        {cases.map((entry, index) => (
          <article class="rounded-2xl border border-neutral-200/90 bg-white p-6 shadow-xs transition-shadow hover:shadow-[0_8px_30px_rgba(0,0,0,0.05)] sm:p-8 lg:p-10">
            <div class="grid gap-8 lg:grid-cols-12 lg:gap-12">
              {/* Identity column */}
              <div class="flex flex-col items-start gap-5 lg:col-span-4">
                <span class="text-xs font-semibold tracking-[0.14em] text-neutral-400 uppercase">
                  Caso {String(index + 1).padStart(2, '0')}
                </span>
                <div class="flex items-center gap-3">
                  <div class="grid size-12 shrink-0 place-items-center overflow-hidden rounded-xl border border-neutral-200/80 bg-white p-1 shadow-xs">
                    <img
                      src={entry.data.logo}
                      alt={entry.data.logoAlt}
                      width="48"
                      height="48"
                      loading="lazy"
                      decoding="async"
                      class="size-full object-contain"
                    />
                  </div>
                  <div>
                    <p class="text-base font-semibold tracking-tight text-ink">
                      {entry.data.facility}
                    </p>
                    <p class="text-xs font-medium text-neutral-500">
                      {entry.data.facilityType}
                    </p>
                  </div>
                </div>
                <CasePhotoFrame
                  src={entry.data.image}
                  alt={entry.data.imageAlt}
                  width={entry.data.imageWidth}
                  height={entry.data.imageHeight}
                  fullBleed
                  class="w-full"
                />
              </div>

              {/* Story column */}
              <div class="lg:col-span-8">
                <h2 class="text-[1.5rem] leading-[1.2] text-ink sm:text-[1.75rem]">
                  {entry.data.title}
                </h2>
                <p class="mt-3 text-[0.9375rem] leading-relaxed text-neutral-600 sm:text-base">
                  {entry.data.summary}
                </p>

                <div class="mt-6 flex flex-wrap items-center gap-2 border-t border-neutral-100 pt-5 text-xs">
                  <span class="font-semibold text-neutral-700">
                    Moduli utilizzati:
                  </span>
                  {entry.data.modules.map((mod) => (
                    <span class="inline-flex items-center gap-1 rounded-md border border-neutral-200/80 bg-neutral-50 px-2.5 py-1.5 text-xs font-medium text-neutral-700">
                      <CaseModuleIcon label={mod} />
                      {mod}
                    </span>
                  ))}
                </div>

                <Button
                  href={`/casi-reali/${entry.id}/`}
                  class="mt-8"
                  size="md"
                >
                  Leggi il caso completo
                  <Icon name="arrow-right" class="size-4" />
                </Button>
              </div>
            </div>
          </article>
        ))}

        {/* Placeholder for future cases */}
        <div class="grid place-items-center rounded-2xl border-2 border-dashed border-neutral-200 px-6 py-10 text-center">
          <p class="text-sm font-medium text-neutral-500">
            Altri casi in arrivo — stiamo raccogliendo nuove storie dalle
            strutture che usano SeasonsJob.
          </p>
        </div>
      </div>
    </div>
  </section>

  <ContactCta />
</BaseLayout>
