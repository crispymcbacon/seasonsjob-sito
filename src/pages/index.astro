---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import Solutions from '@/components/sections/Solutions.astro';
import WhySeasonsJob from '@/components/sections/WhySeasonsJob.astro';
import FieldWork from '@/components/sections/FieldWork.astro';
import ContactCta from '@/components/sections/ContactCta.astro';
import { SITE } from '@/config/site';

const title = 'SeasonsJob — Strumenti digitali per l’hospitality';
const description =
  'SeasonsJob progetta prodotti specializzati per hotel, ristoranti e strutture ricettive: Lavoro, Comande, Procuro e Wine. Personale stagionale, comande, acquisti e cantina.';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
};
---

<BaseLayout title={title} description={description} canonical="/">
  <script
    type="application/ld+json"
    is:inline
    slot="head"
    set:html={JSON.stringify(structuredData)}
  ></script>
  <Hero />
  <Solutions />
  <WhySeasonsJob />
  <FieldWork />
  <ContactCta />
</BaseLayout>
