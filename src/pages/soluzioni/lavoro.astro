---
import SolutionPage from '@/components/sections/SolutionPage.astro';
import { LAVORO_APP } from '@/config/site';
---

<SolutionPage
  slug="lavoro"
  description="La piattaforma SeasonsJob Lavoro per il personale stagionale è ora su lavoro.seasonsjob.it."
>
  <p class="mx-auto mt-6 text-sm text-neutral-500">
    Lavoro ora si trova su
    <a
      href={LAVORO_APP.url}
      class="font-medium text-neutral-700 underline decoration-neutral-300 underline-offset-2 hover:text-brand-700"
    >
      lavoro.seasonsjob.it
    </a>
    : aggiorna segnalibri e accessi precedenti.
  </p>
</SolutionPage>
